    <string name="touch_compat_shaders">Shader shortcuts off *</string>
    <string name="touch_compat_shaders_help">Plainer shader code. Shaders rebuild once (several minutes).</string>
    <string name="touch_compat_gpl">Pipeline libraries off *</string>
    <string name="touch_compat_gpl_help">Builds each GPU pipeline in one piece. New effects take longer to appear.</string>
