    <string name="touch_section_compat">GPU compatibility (testing)</string>
    <string name="touch_compat_help">For phones whose picture is wrong or whose game stops with a GPU error (for example the Adreno 600 series). Try one option at a time, with Debug logging on, and save the logs after each try.</string>
