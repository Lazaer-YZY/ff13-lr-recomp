From 00005055b66f323a0349820e1e66b9138deb1b6a Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sat, 7 Nov 2026 14:16:53 +0800
Subject: [PATCH 005/108] scripts: add configure_android.sh for the NDK arm64
 configure

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/scripts/configure_android.sh b/scripts/configure_android.sh
new file mode 100644
index 0000000..4c79f9e
--- /dev/null
+++ b/scripts/configure_android.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# Configure the ReXGlue SDK for Android arm64 with the NDK toolchain.
+# Usage (Git Bash, from the SDK root): source /c/lr/tools/env.sh && scripts/configure_android.sh
+set -euo pipefail
+cd "$(dirname "$0")/.."
+NDK="${ANDROID_NDK_ROOT_CMAKE:-C:/dev/android-sdk/ndk/28.2.13676358}"
+cmake -S . -B out/build/android-arm64 -G Ninja \
+  -DCMAKE_TOOLCHAIN_FILE="$NDK/build/cmake/android.toolchain.cmake" \
+  -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-26 -DANDROID_STL=c++_shared \
+  -DCMAKE_BUILD_TYPE=Release -DREXGLUE_USE_VULKAN=ON -DREXGLUE_ENABLE_TRACY=OFF -DREXGLUE_BUILD_TESTS=OFF \
+  -DCMAKE_INSTALL_PREFIX=C:/dev/rexglue-android "$@"
