     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_BOOL(spirv_vertex_texture_sign_specialization, false, "GPU/Vulkan",
+                    "spirv_texture_sign_specialization for vertex shaders too (their first 3 used "
+                    "textures; Lightning Returns' vertex textures, fetch constant 16: the sign and "
