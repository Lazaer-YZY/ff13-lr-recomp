+                    "default: measured no gain on the Thor (plaza 16.0 vs 16.05 ms GPU, warp 12.4 "
+                    "either way; the removed code sat behind uniform branches already skipped).")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
