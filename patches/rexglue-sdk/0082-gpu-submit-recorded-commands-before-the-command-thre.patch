   virtual void MakeCoherent();
+  struct WaitRegMemStats {
+    uint64_t start_us = 0, waits = 0, unblocked = 0, us = 0, max_us = 0;
+    uint32_t top_key = 0, top_info = 0, top_ref = 0, top_mask = 0;
+    uint64_t top_us = 0, other_us = 0;
+  };
+  WaitRegMemStats wait_reg_mem_stats_;
   virtual void PrepareForWait();
   virtual void ReturnFromWait();
 
