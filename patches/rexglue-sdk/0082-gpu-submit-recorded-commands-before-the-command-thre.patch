     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(gpu_log_wait_reg_mem, true, "GPU",
+                    "Every 10 s, log the WAIT_REG_MEM packets that had to wait: count, time "
+                    "the GPU command thread slept, and the most waited-on address/register.");
+REXCVAR_DEFINE_UINT32(gpu_wait_reg_mem_sleep_us, 0, "GPU",
+                      "Poll interval of a WAIT_REG_MEM packet that has to wait (0 = the packet's "
+                      "own interval, whole milliseconds as in Xenia).");
 REXCVAR_DEFINE_BOOL(gpu_command_wait_untimed, true, "GPU",
                     "The GPU command thread waits for new commands without a timeout (no "
                     "clock reads; woken by write pointer updates, CallInThread, Shutdown).");
@@ -1004,6 +1010,8 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
   bool is_memory = (wait_info & 0x10) != 0;
 
   bool matched = false;
+  uint64_t wait_start_us = 0;
+  uint32_t polls = 0;
   do {
     uint32_t value = 0;
     if (is_memory) {
@@ -1044,12 +1052,20 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         break;
     }
     if (!matched) {
+      if (!polls++) {
+        wait_start_us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count());
+      }
       // Wait.
       if (wait >= 0x100) {
         PrepareForWait();
+        const uint32_t sleep_us = REXCVAR_GET(gpu_wait_reg_mem_sleep_us);
         if (!REXCVAR_GET(vsync)) {
           // User wants it fast and dangerous.
           rex::thread::MaybeYield();
+        } else if (sleep_us) {
+          rex::thread::Sleep(std::chrono::microseconds(sleep_us));
         } else {
           rex::thread::Sleep(std::chrono::milliseconds(wait / 0x100));
         }
@@ -1066,6 +1082,42 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
     }
   } while (!matched);
 
+  if (REXCVAR_GET(gpu_log_wait_reg_mem)) {
+    const uint64_t now_us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+    auto& st = wait_reg_mem_stats_;
+    if (polls) {
+      const uint64_t us = now_us - wait_start_us;
+      ++st.waits;
+      st.us += us;
+      st.max_us = std::max(st.max_us, us);
+      const uint32_t key = poll_reg_addr | (is_memory ? 0 : 0x80000000u);
+      if (key == st.top_key || st.top_key == 0) {
+        st.top_key = key;
+        st.top_us += us;
+        st.top_info = wait_info;
+        st.top_ref = ref;
+        st.top_mask = mask;
+      } else {
+        st.other_us += us;
+      }
+    } else {
+      ++st.unblocked;
+    }
+    if (!st.start_us) st.start_us = now_us;
+    if (now_us - st.start_us >= 10000000) {
+      REXGPU_INFO(
+          "GPU WAIT_REG_MEM (10 s): {} waits that had to wait, {:.1f} ms slept (longest {:.2f} "
+          "ms), {} passed at once; most: {} {:08X} (info {:02X} ref {:08X} mask {:08X}) {:.1f} "
+          "ms, others {:.1f} ms",
+          st.waits, st.us / 1000.0, st.max_us / 1000.0, st.unblocked,
+          (st.top_key & 0x80000000u) ? "register" : "memory", st.top_key & 0x7FFFFFFFu,
+          st.top_info, st.top_ref, st.top_mask, st.top_us / 1000.0, st.other_us / 1000.0);
+      st = WaitRegMemStats();
+      st.start_us = now_us;
+    }
+  }
   return true;
 }
 
