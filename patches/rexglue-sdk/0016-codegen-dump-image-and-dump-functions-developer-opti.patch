+// Same range the writer emits as REX_CODE_BASE/REX_CODE_SIZE (and the runtime
+// logs as "Function table initialized for module: code=...").
+std::pair<uint32_t, uint32_t> ExecutableRange(const BinaryView& binary) {
+  uint32_t code_min = ~uint32_t(0);
+  uint32_t code_max = 0;
+  for (const auto& section : binary.sections()) {
+    if (section.executable) {
+      code_min = std::min(code_min, section.baseAddress);
+      code_max = std::max(code_max, section.baseAddress + section.size);
+    }
+  }
+  return {code_min, code_max};
+}
+
+bool DumpGuestImage(const std::filesystem::path& path, const rex::runtime::XexModule& xex,
+                    const BinaryView& binary) {
+  const uint32_t base = xex.base_address();
+  const uint32_t size = xex.image_size();
+  const uint8_t* bytes = xex.memory()->TranslateVirtual<const uint8_t*>(base);
+  if (!bytes || !size) {
+    REXLOG_ERROR("--dump-image: entrypoint image is not mapped");
+    return false;
+  }
+  if (!WriteFileBytes(path, std::string_view(reinterpret_cast<const char*>(bytes), size))) {
+    REXLOG_ERROR("--dump-image: failed to write {}", path.string());
+    return false;
+  }
+
+  auto hex = [](uint32_t v) { return fmt::format("0x{:08X}", v); };
+  auto [code_start, code_end] = ExecutableRange(binary);
+  nlohmann::ordered_json sections = nlohmann::ordered_json::array();
+  for (const auto& section : binary.sections()) {
+    sections.push_back({
+        {"name", std::string(section.name)},
+        {"address", hex(section.baseAddress)},
+        {"size", hex(section.size)},
+        {"flags", section.executable ? "x" : ""},
+    });
+  }
+  nlohmann::ordered_json meta = {
+      {"image_base", hex(base)},
+      {"image_size", hex(size)},
+      {"entry_point", hex(binary.entryPoint())},
+      {"code_start", hex(code_start)},
+      {"code_end", hex(code_end)},
+      {"sections", std::move(sections)},
+  };
+  std::filesystem::path json_path = path;
+  json_path += ".json";
+  if (!WriteFileBytes(json_path, meta.dump(2) + "\n")) {
+    REXLOG_ERROR("--dump-image: failed to write {}", json_path.string());
+    return false;
+  }
+  REXLOG_INFO("Dumped guest image {:08X}+{:X} to {}", base, size, path.string());
+  return true;
+}
+
+bool DumpFunctions(const std::filesystem::path& path, const CodegenContext& ctx) {
+  std::vector<const FunctionNode*> functions;
+  functions.reserve(ctx.graph.functionCount());
+  for (const auto& [addr, node] : ctx.graph.functions()) {
+    functions.push_back(node.get());
+  }
+  std::sort(functions.begin(), functions.end(),
+            [](const auto* a, const auto* b) { return a->base() < b->base(); });
+
+  std::unordered_map<uint32_t, std::string> rexcrt_by_addr;
+  for (const auto& [name, addr] : ctx.Config().rexcrtFunctions) {
+    rexcrt_by_addr[addr] = fmt::format("rexcrt_{}", name);
+  }
+
+  std::string out;
+  out.reserve(functions.size() * 48);
+  for (const auto* fn : functions) {
+    // Naming mirrors CodegenWriter (buildTemplateData).
+    std::string name;
+    if (auto it = rexcrt_by_addr.find(fn->base()); it != rexcrt_by_addr.end()) {
+      name = it->second;
+    } else if (fn->base() == ctx.analysisState().entryPoint) {
+      name = "xstart";
+    } else if (!fn->name().empty()) {
+      name = fn->name();
+    } else {
+      name = fmt::format("sub_{:08X}", fn->base());
+    }
+    std::string authority = AuthorityName(fn->authority());
+    std::transform(authority.begin(), authority.end(), authority.begin(),
+                   [](unsigned char c) { return char(std::toupper(c)); });
+    out += fmt::format("0x{:08X} 0x{:X} {} {}\n", fn->base(), fn->size(), name, authority);
+  }
+  if (!WriteFileBytes(path, out)) {
+    REXLOG_ERROR("--dump-functions: failed to write {}", path.string());
+    return false;
+  }
+  REXLOG_INFO("Dumped {} function(s) to {}", functions.size(), path.string());
+  return true;
+}
+
 }  // namespace
 
