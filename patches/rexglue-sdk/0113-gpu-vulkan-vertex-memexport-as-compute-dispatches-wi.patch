+// vulkan_memexport_shader_stats: per vertex shader with memory export, what its draws did, at most
+// every 10 s (one line per vertex shader seen since the last report, the 16 with the most draws).
+// Command processor thread only.
+enum class VertexMemexportPath : uint32_t {
+  kStores,   // Vertex shader stores (the device has vertexPipelineStoresAndAtomics).
+  kCompute,  // Compute dispatch.
+  kSkipped,  // Left out: no vertex stores and vulkan_vertex_memexport_compute off.
+  kRefused,  // Left out by the compute path.
+  kDropped,  // Not drawn for another reason (pipeline still compiling, draw failure).
+  kCount,
+};
+struct VertexMemexportShaderStats {
+  uint64_t draws = 0;
+  uint64_t vertices = 0;
+  uint64_t export_bytes = 0;
+  uint64_t rasterized = 0;
+  uint64_t overlapping = 0;
+  uint64_t paths[size_t(VertexMemexportPath::kCount)] = {};
+};
+struct VertexMemexportStatsLog {
+  std::unordered_map<uint64_t, VertexMemexportShaderStats> shaders;
+  std::chrono::steady_clock::time_point window_start;
+
+  void ReportIfDue() {
+    if (shaders.empty()) {
+      return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - window_start < std::chrono::seconds(10)) {
+      return;
+    }
+    std::vector<std::pair<uint64_t, const VertexMemexportShaderStats*>> sorted;
+    sorted.reserve(shaders.size());
+    uint64_t total_draws = 0;
+    for (const auto& shader : shaders) {
+      sorted.emplace_back(shader.first, &shader.second);
+      total_draws += shader.second.draws;
+    }
+    std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) {
+      return a.second->draws > b.second->draws ||
+             (a.second->draws == b.second->draws && a.first < b.first);
+    });
+    REXGPU_INFO("Vertex memexport shader stats over {:.1f} s: {} vertex shaders, {} draws",
+                std::chrono::duration<double>(now - window_start).count(), shaders.size(),
+                total_draws);
+    const size_t listed = std::min(sorted.size(), size_t(16));
+    for (size_t i = 0; i < listed; ++i) {
+      const VertexMemexportShaderStats& stats = *sorted[i].second;
+      REXGPU_INFO(
+          "Vertex memexport VS {:016X}: {} draws, {} vertices, {} export bytes, {} rasterized, {} with "
+          "exports overlapping their inputs; paths: {} vertex stores, {} compute, {} skipped, {} "
+          "refused, {} dropped",
+          sorted[i].first, stats.draws, stats.vertices, stats.export_bytes, stats.rasterized,
+          stats.overlapping, stats.paths[size_t(VertexMemexportPath::kStores)],
+          stats.paths[size_t(VertexMemexportPath::kCompute)],
+          stats.paths[size_t(VertexMemexportPath::kSkipped)],
+          stats.paths[size_t(VertexMemexportPath::kRefused)],
+          stats.paths[size_t(VertexMemexportPath::kDropped)]);
+    }
+    if (sorted.size() > listed) {
+      uint64_t more_draws = 0;
+      for (size_t i = listed; i < sorted.size(); ++i) {
+        more_draws += sorted[i].second->draws;
+      }
+      REXGPU_INFO("Vertex memexport shader stats: +{} more vertex shaders ({} draws)",
+                  sorted.size() - listed, more_draws);
+    }
+    shaders.clear();
+  }
+};
+VertexMemexportStatsLog vertex_memexport_stats_log;
+
+// One vertex memexport draw's record for vulkan_memexport_shader_stats, made when IssueDraw returns
+// (whichever way). Inactive (records nothing) unless the stats are on.
+struct VertexMemexportDrawRecord {
+  bool active = false;
+  uint64_t vertex_shader_hash = 0;
+  uint32_t vertices = 0;
+  uint64_t export_bytes = 0;
+  bool overlapping = false;
+  bool rasterized = false;
+  VertexMemexportPath path = VertexMemexportPath::kDropped;
+  ~VertexMemexportDrawRecord() {
+    if (!active) {
+      return;
+    }
+    if (vertex_memexport_stats_log.shaders.empty()) {
+      vertex_memexport_stats_log.window_start = std::chrono::steady_clock::now();
+    }
+    VertexMemexportShaderStats& stats = vertex_memexport_stats_log.shaders[vertex_shader_hash];
+    ++stats.draws;
+    stats.vertices += vertices;
+    stats.export_bytes += export_bytes;
+    stats.rasterized += rasterized ? 1 : 0;
+    stats.overlapping += overlapping ? 1 : 0;
+    ++stats.paths[size_t(path)];
+    vertex_memexport_stats_log.ReportIfDue();
+  }
+};
