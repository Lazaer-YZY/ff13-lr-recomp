+// Whether a vertex shader's memory export ranges overlap what the draw reads as input: its guest
+// index buffer (DMA indices) and the ranges of its vertex fetch constants. Unknown destinations (no
+// ranges for a vertex shader that exports) count as overlapping.
+bool VertexMemexportOverlapsInputs(const RegisterFile& regs, const Shader& vertex_shader,
+                                   const draw_util::MemExportRange* ranges, size_t range_count) {
+  if (!range_count) {
+    return true;
+  }
+  auto overlaps_export = [ranges, range_count](uint64_t address, uint64_t size) {
+    for (size_t i = 0; i < range_count; ++i) {
+      const uint64_t begin = uint64_t(ranges[i].base_address_dwords) << 2;
+      if (size && address < begin + ranges[i].size_bytes && begin < address + size) {
+        return true;
+      }
+    }
+    return false;
+  };
+  const auto initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (initiator.source_select == xenos::SourceSelect::kDMA) {
+    const uint32_t index_size = initiator.index_size == xenos::IndexFormat::kInt32 ? 4 : 2;
+    const uint32_t index_count = std::min(uint32_t(initiator.num_indices),
+                                          uint32_t(regs.Get<reg::VGT_DMA_SIZE>().num_words));
+    const uint32_t index_base = regs[XE_GPU_REG_VGT_DMA_BASE] & ~(index_size - 1);
+    if (overlaps_export(index_base, uint64_t(index_count) * index_size)) {
+      return true;
+    }
+  }
+  const Shader::ConstantRegisterMap& constants = vertex_shader.constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(constants.vertex_fetch_bitmap); ++i) {
+    uint32_t remaining = constants.vertex_fetch_bitmap[i], bit;
+    while (rex::bit_scan_forward(remaining, &bit)) {
+      remaining &= ~(uint32_t(1) << bit);
+      const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(i * 32 + bit);
+      if (overlaps_export(uint64_t(fetch.address) << 2, uint64_t(fetch.size) << 2)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
 
