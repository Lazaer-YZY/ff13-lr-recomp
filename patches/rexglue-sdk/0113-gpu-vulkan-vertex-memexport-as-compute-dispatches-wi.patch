+      shader, Shader::HostVertexShaderType::kMemExportCompute, 0, false);
+  // Only the memory export runs: nothing that depends on rasterization state, so one translation
+  // serves every draw of the shader.
+  modification.vertex.user_clip_plane_count = 0;
+  modification.vertex.user_clip_plane_cull = 0;
+  modification.vertex.vertex_kill_and = 0;
+  modification.vertex.output_point_parameters = 0;
+  modification.vertex.point_ps_ucp_mode = 0;
+  modification.vertex.clamp_depth = 0;
+  auto* translation = static_cast<VulkanShader::VulkanTranslation*>(
+      shader.GetOrCreateTranslation(modification.value));
+  if (!EnsureShadersTranslated(translation, nullptr)) {
+    return VK_NULL_HANDLE;
+  }
+  const auto key = std::make_pair(translation, layout);
+  auto found = vertex_memexport_compute_pipelines_.find(key);
+  if (found != vertex_memexport_compute_pipelines_.end()) {
+    return found->second;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  VkComputePipelineCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+  create_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  create_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  create_info.stage.module = translation->shader_module();
+  create_info.stage.pName = "main";
+  create_info.layout = layout;
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  if (vulkan_device->functions().vkCreateComputePipelines(
+          vulkan_device->device(), vulkan_device->pipeline_cache(), 1, &create_info, nullptr,
+          &pipeline) != VK_SUCCESS) {
+    REXGPU_ERROR("Failed to create the vertex memory export compute pipeline for {:016X}",
+                 shader.ucode_data_hash());
+    pipeline = VK_NULL_HANDLE;
+  }
+  vertex_memexport_compute_pipelines_.emplace(key, pipeline);
+  return pipeline;
+}
