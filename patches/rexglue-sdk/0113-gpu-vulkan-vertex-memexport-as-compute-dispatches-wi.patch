+  // The guest processing indices, not the converted triangle or rectangle stream (a converted
+  // primitive may repeat or invent vertices): every guest vertex is processed once.
+  PrimitiveProcessor::ProcessingResult compute_primitives = primitives;
+  compute_primitives.host_vertex_shader_type = Shader::HostVertexShaderType::kVertex;
+  compute_primitives.index_buffer_type =
+      indexed ? PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA
+              : PrimitiveProcessor::ProcessedIndexBufferType::kNone;
+  compute_primitives.guest_index_base = index_base;
+  compute_primitives.host_primitive_reset_enabled = false;
