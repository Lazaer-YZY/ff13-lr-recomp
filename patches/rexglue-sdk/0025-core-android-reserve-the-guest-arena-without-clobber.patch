From f9e2522c5cde8a73a50a5c6195063173578da702 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sat, 7 Nov 2026 17:46:40 +0800
Subject: [PATCH 025/108] core(android): reserve the guest arena without
 clobbering app mappings (behaviour informed by lr-ffxiii-port's Android
 patch, re-implemented)

MapViews maps the guest views with MAP_FIXED, which silently replaces any
existing mapping at the candidate base; in an Android app process that can be
ART or allocator memory. On Android each candidate base first reserves the
whole 0x120000000-byte arena with MAP_FIXED_NOREPLACE (address checked for
pre-4.17 kernels), so the views only replace our own reservation. If no
candidate is free, any 4 GB-aligned free range is reserved and used.
All platforms: the 'Recovered stale physical page protection' warning is
logged at most 16 times.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/src/system/xmemory.cpp b/src/system/xmemory.cpp
index d0a97c9..e5fff79 100644
--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -10,10 +10,11 @@
  */
 
 #include <algorithm>
+#include <atomic>
 #include <cstring>
 #include <utility>
 
-#if REX_PLATFORM_MAC
+#if REX_PLATFORM_MAC || REX_PLATFORM_ANDROID
 #include <sys/mman.h>
 #endif
 
@@ -42,6 +43,53 @@ REXCVAR_DEFINE_BOOL(protect_on_release, false, "Memory",
 
 REXCVAR_DEFINE_BOOL(scribble_heap, false, "Memory", "Scribble 0xCD into all allocated heap memory");
 
+#if REX_PLATFORM_ANDROID
+namespace {
+#ifndef MAP_FIXED_NOREPLACE
+#define MAP_FIXED_NOREPLACE 0x100000
+#endif
+// Whole guest arena: virtual 0x0'00000000 .. physical end 0x1'1FFFFFFF.
+constexpr size_t kAndroidGuestRangeSize = 0x120000000ull;
+
+// Reserves [base, base + size) without replacing existing mappings. Kernels
+// older than 4.17 treat MAP_FIXED_NOREPLACE as a hint, so the result address
+// is checked as well.
+bool AndroidReserveGuestRange(uint8_t* base) {
+  void* p = mmap(base, kAndroidGuestRangeSize, PROT_NONE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+  if (p == MAP_FAILED) {
+    return false;
+  }
+  if (p != base) {
+    munmap(p, kAndroidGuestRangeSize);
+    return false;
+  }
+  return true;
+}
+
+// Reserves a 4 GB-aligned free range anywhere (over-reserve, then trim).
+uint8_t* AndroidReserveAnyAlignedGuestRange() {
+  constexpr size_t kAlign = 0x100000000ull;
+  void* p = mmap(nullptr, kAndroidGuestRangeSize + kAlign, PROT_NONE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  if (p == MAP_FAILED) {
+    return nullptr;
+  }
+  const uintptr_t start = reinterpret_cast<uintptr_t>(p);
+  const uintptr_t aligned = (start + kAlign - 1) & ~uintptr_t(kAlign - 1);
+  const uintptr_t end = start + kAndroidGuestRangeSize + kAlign;
+  const uintptr_t used_end = aligned + kAndroidGuestRangeSize;
+  if (aligned > start) {
+    munmap(p, aligned - start);
+  }
+  if (end > used_end) {
+    munmap(reinterpret_cast<void*>(used_end), end - used_end);
+  }
+  return reinterpret_cast<uint8_t*>(aligned);
+}
+}  // namespace
+#endif  // REX_PLATFORM_ANDROID
+
 namespace rex::memory {
 
 uint32_t get_page_count(uint32_t value, uint32_t page_size, uint32_t page_size_shift) {
@@ -164,11 +212,38 @@ bool Memory::Initialize() {
   mapping_base_ = 0;
   for (size_t n = 32; n < 64; n++) {
     auto mapping_base = reinterpret_cast<uint8_t*>(1ull << n);
+#if REX_PLATFORM_ANDROID
+    // The views are mapped with MAP_FIXED, which would silently replace
+    // whatever the app process (ART, the allocator, ...) already has there.
+    // Claim the whole range first without replacing anything.
+    if (!AndroidReserveGuestRange(mapping_base)) {
+      continue;
+    }
+    if (MapViews(mapping_base)) {
+      munmap(mapping_base, kAndroidGuestRangeSize);
+      continue;
+    }
+    mapping_base_ = mapping_base;
+    break;
+#else
     if (!MapViews(mapping_base)) {
       mapping_base_ = mapping_base;
       break;
     }
+#endif
+  }
+#if REX_PLATFORM_ANDROID
+  if (!mapping_base_) {
+    // No fixed candidate was free: take any 4 GB-aligned free range.
+    if (uint8_t* mapping_base = AndroidReserveAnyAlignedGuestRange()) {
+      if (!MapViews(mapping_base)) {
+        mapping_base_ = mapping_base;
+      } else {
+        munmap(mapping_base, kAndroidGuestRangeSize);
+      }
+    }
   }
+#endif
   if (!mapping_base_) {
     REXSYS_ERROR("Unable to find a continuous block in the 64bit address space.");
     assert_always();
@@ -613,10 +688,15 @@ bool Memory::AccessViolationCallback(std::unique_lock<std::recursive_mutex> glob
           reinterpret_cast<uintptr_t>(host_address) & ~(uintptr_t(host_page_size - 1));
       if (rex::memory::Protect(reinterpret_cast<void*>(page_base), host_page_size,
                                rex::memory::PageAccess::kReadWrite, nullptr)) {
-        REXSYS_WARN(
-            "Recovered stale physical page protection for guest {:08X} (host {:016X}, "
-            "guest_protect {:08X})",
-            virtual_address, static_cast<uint64_t>(page_base), guest_protect);
+        // Also the normal outcome of a write racing another thread's unwatch
+        // (see MMIOHandler), so only the first few are logged.
+        static std::atomic<uint32_t> recovered_logged{0};
+        if (recovered_logged.fetch_add(1, std::memory_order_relaxed) < 16) {
+          REXSYS_WARN(
+              "Recovered stale physical page protection for guest {:08X} (host {:016X}, "
+              "guest_protect {:08X})",
+              virtual_address, static_cast<uint64_t>(page_base), guest_protect);
+        }
         return true;
       }
     }
