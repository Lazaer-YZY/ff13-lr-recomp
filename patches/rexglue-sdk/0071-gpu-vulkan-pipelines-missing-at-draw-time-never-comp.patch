From 2aa810af308a5fe6d6a0302a6ee02db893179f43 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sun, 8 Nov 2026 23:47:42 +0800
Subject: [PATCH 071/108] gpu: vulkan: pipelines missing at draw time never
 compile on the GPU thread

With async_shader_compilation, a pipeline missing at draw time was given a
placeholder pipeline compiled synchronously (vertex shader included), draws
without a pixel shader compiled synchronously, and every EndSubmission drained
the creation queue on the GPU thread and waited for the creation threads (a
Direct3D 12 heritage). On the Thor a compile costs ~170 ms of CPU, so a burst
stalled the GPU thread and with it the game.

vulkan_pipeline_compile_never_blocks (default on): a miss marks the entry
pending and queues it for the creation threads; its draws are skipped (and the
frame held, vulkan_async_skip_incomplete_frames) until it is published; no
placeholder, no drain or wait at submission end; a failed background creation
clears the pending state. Counters every 10 s: pipelines queued / created
synchronously (ms) / shader translations on the GPU thread (ms) / draws skipped
/ frames held. Cache-off boot: 0 synchronous creations, 21 queued, game frames
over 45 ms 6 then 0-2 per 10 s.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 9904115..4392f43 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -647,6 +647,12 @@ class VulkanCommandProcessor : public CommandProcessor {
   // Tracks whether any draw in the current frame used an async placeholder
   // graphics pipeline and may have produced incomplete output.
   bool frame_used_async_placeholder_pipeline_ = false;
+  // Pipeline / shader work at draw time, logged every 10 s ("Pipelines (10 s)").
+  uint32_t counter_draws_skipped_pending_ = 0;
+  uint32_t counter_frames_held_ = 0;
+  uint32_t counter_frames_presented_ = 0;
+  uint64_t pipeline_counters_last_log_ns_ = 0;
+  void LogPipelineCountersIfDue();
   // Guest frame index, since some transient resources can be reused across
   // submissions. Values updated in the beginning of a frame.
   uint64_t frame_current_ = 1;
diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
