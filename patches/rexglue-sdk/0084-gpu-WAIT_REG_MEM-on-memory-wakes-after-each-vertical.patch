From 5a6f35ff57413d2ff2f262ad2129b0e595c8ff08 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Mon, 9 Nov 2026 13:35:29 +0800
Subject: [PATCH 084/108] gpu: WAIT_REG_MEM on memory wakes after each vertical
 blank interrupt; vblank phase stats; experimental skip

Lightning Returns waits once per frame (WAIT_REG_MEM on a guest counter) for the
previous frame's flip, which the guest's vertical blank handler records: 83% of
those waits ended <1 ms after an emulated vertical blank. The command thread now
sleeps on a condition variable notified after each vertical blank interrupt
(gpu_wait_reg_mem_wake_on_vblank, default on) instead of fixed 1 ms sleeps.
gpu_wait_reg_mem_skip_memory (default off) treats such waits as satisfied: on the
Thor it removed the guest's render-submission wait but frame times stayed the same.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index f7f7854..419eabe 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -11,6 +11,8 @@
 
 #pragma once
 
+#include <condition_variable>
+#include <mutex>
 #include <atomic>
 #include <cstring>
 #include <functional>
@@ -86,6 +88,15 @@ class CommandProcessor {
 
   uint32_t counter() const { return counter_; }
   void increment_counter() { counter_++; }
+  // Called after each vertical blank interrupt has run (the guest ISR may have written memory
+  // a WAIT_REG_MEM polls): wakes a WAIT_REG_MEM sleeping for it (gpu_wait_reg_mem_wake_on_vblank).
+  void OnVblankInterruptDone() {
+    {
+      std::lock_guard<std::mutex> lock(vblank_wake_mutex_);
+      ++vblank_wake_generation_;
+    }
+    vblank_wake_cv_.notify_all();
+  }
 
   Shader* active_vertex_shader() const { return active_vertex_shader_; }
   Shader* active_pixel_shader() const { return active_pixel_shader_; }
@@ -175,8 +186,13 @@ class CommandProcessor {
     uint64_t start_us = 0, waits = 0, unblocked = 0, us = 0, max_us = 0;
     uint32_t top_key = 0, top_info = 0, top_ref = 0, top_mask = 0;
     uint64_t top_us = 0, other_us = 0;
+    uint32_t after_vblank[4] = {};
+    uint64_t skipped = 0;
   };
   WaitRegMemStats wait_reg_mem_stats_;
+  std::mutex vblank_wake_mutex_;
+  std::condition_variable vblank_wake_cv_;
+  uint64_t vblank_wake_generation_ = 0;
   virtual void PrepareForWait();
   virtual void ReturnFromWait();
 
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index ac6b056..b9d47bc 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -48,6 +48,8 @@ class CommandProcessor;
 
 class GraphicsSystem : public system::IGraphicsSystem {
  public:
+  // steady_clock microseconds of the last emulated vertical blank (diagnostics).
+  static std::atomic<uint64_t> last_vblank_us;
   virtual ~GraphicsSystem();
 
   virtual std::string name() const = 0;
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 3b45be0..87a198a 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -45,6 +45,16 @@ REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
 REXCVAR_DEFINE_BOOL(gpu_log_wait_reg_mem, true, "GPU",
                     "Every 10 s, log the WAIT_REG_MEM packets that had to wait: count, time "
                     "the GPU command thread slept, and the most waited-on address/register.");
+REXCVAR_DEFINE_BOOL(gpu_wait_reg_mem_wake_on_vblank, true, "GPU",
+                    "A WAIT_REG_MEM polling memory sleeps until the next vertical blank "
+                    "interrupt has run (or its own interval passes) instead of a fixed sleep, so "
+                    "it resumes right after the guest's interrupt handler writes the value "
+                    "(Lightning Returns waits for the frame flip once per frame).");
+REXCVAR_DEFINE_BOOL(gpu_wait_reg_mem_skip_memory, false, "GPU",
+                    "Experimental: never wait in a WAIT_REG_MEM that polls memory (treat it as "
+                    "satisfied). Lightning Returns uses one per frame to wait for the previous "
+                    "frame's flip; the host presenter copies the frame at swap, so the GPU need "
+                    "not wait for scanout. May break titles that sync the GPU to the CPU this way.");
 REXCVAR_DEFINE_UINT32(gpu_wait_reg_mem_sleep_us, 0, "GPU",
                       "Poll interval of a WAIT_REG_MEM packet that has to wait (0 = the packet's "
                       "own interval, whole milliseconds as in Xenia).");
@@ -1051,6 +1061,10 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         matched = true;
         break;
     }
+    if (!matched && is_memory && REXCVAR_GET(gpu_wait_reg_mem_skip_memory)) {
+      matched = true;
+      ++wait_reg_mem_stats_.skipped;
+    }
     if (!matched) {
       if (!polls++) {
         wait_start_us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
@@ -1064,6 +1078,11 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         if (!REXCVAR_GET(vsync)) {
           // User wants it fast and dangerous.
           rex::thread::MaybeYield();
+        } else if (is_memory && REXCVAR_GET(gpu_wait_reg_mem_wake_on_vblank)) {
+          std::unique_lock<std::mutex> lock(vblank_wake_mutex_);
+          const uint64_t generation = vblank_wake_generation_;
+          vblank_wake_cv_.wait_for(lock, std::chrono::milliseconds(std::max(1u, wait / 0x100)),
+                                   [&] { return vblank_wake_generation_ != generation; });
         } else if (sleep_us) {
           rex::thread::Sleep(std::chrono::microseconds(sleep_us));
         } else {
@@ -1089,6 +1108,10 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
     auto& st = wait_reg_mem_stats_;
     if (polls) {
       const uint64_t us = now_us - wait_start_us;
+      // When the wait ended relative to the last emulated vertical blank.
+      const uint64_t vblank_us = GraphicsSystem::last_vblank_us.load(std::memory_order_relaxed);
+      const uint64_t since = now_us > vblank_us ? now_us - vblank_us : 0;
+      ++st.after_vblank[since < 1000 ? 0 : since < 4000 ? 1 : since < 8000 ? 2 : 3];
       ++st.waits;
       st.us += us;
       st.max_us = std::max(st.max_us, us);
@@ -1110,10 +1133,13 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
       REXGPU_INFO(
           "GPU WAIT_REG_MEM (10 s): {} waits that had to wait, {:.1f} ms slept (longest {:.2f} "
           "ms), {} passed at once; most: {} {:08X} (info {:02X} ref {:08X} mask {:08X}) {:.1f} "
-          "ms, others {:.1f} ms",
+          "ms, others {:.1f} ms; ended after a vertical blank by <1 ms {}, 1-4 ms {}, 4-8 ms {}, "
+          ">8 ms {}; skipped {}",
           st.waits, st.us / 1000.0, st.max_us / 1000.0, st.unblocked,
           (st.top_key & 0x80000000u) ? "register" : "memory", st.top_key & 0x7FFFFFFFu,
-          st.top_info, st.top_ref, st.top_mask, st.top_us / 1000.0, st.other_us / 1000.0);
+          st.top_info, st.top_ref, st.top_mask, st.top_us / 1000.0, st.other_us / 1000.0,
+          st.after_vblank[0], st.after_vblank[1], st.after_vblank[2], st.after_vblank[3],
+          st.skipped);
       st = WaitRegMemStats();
       st.start_us = now_us;
     }
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index d0b1d37..c30d17d 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -9,6 +9,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <chrono>
 #include <rex/graphics/graphics_system.h>
 
 #include <algorithm>
@@ -366,7 +367,13 @@ void GraphicsSystem::DispatchInterruptCallback(uint32_t source, uint32_t cpu) {
                                          rex::countof(args));
 }
 
+std::atomic<uint64_t> GraphicsSystem::last_vblank_us{0};
+
 void GraphicsSystem::MarkVblank() {
+  last_vblank_us.store(uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count()),
+                       std::memory_order_relaxed);
   // TODO: Enable profiling once ported
   // SCOPE_profile_cpu_f("gpu");
 
@@ -379,6 +386,9 @@ void GraphicsSystem::MarkVblank() {
   //     something wrong and the CP will block waiting for code that
   //     needs to be run in the interrupt.
   DispatchInterruptCallback(0, 2);
+  if (command_processor_) {
+    command_processor_->OnVblankInterruptDone();
+  }
 }
 
 void GraphicsSystem::ClearCaches() {
