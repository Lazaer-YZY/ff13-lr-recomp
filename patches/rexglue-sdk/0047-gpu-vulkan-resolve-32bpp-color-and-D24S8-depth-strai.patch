+
+// ReXGlue: resolve_fast_32bpp_1x2xmsaa.xesli (xenia-canary 65d42843b6) reading
+// the samples straight from the host render target that owns the resolved
+// EDRAM range instead of from the EDRAM buffer, so the render target doesn't
+// have to be dumped to the EDRAM buffer first (one less full-size copy).
+// GLSL only. Variants:
+// - XE_RESOLVE_HOST_RT_UINT: 32-bit integer view (k_32_FLOAT as R32_UINT),
+//   otherwise a UNORM view of k_8_8_8_8 packed like the EDRAM dump does.
+// - XE_RESOLVE_HOST_RT_DEPTH: kD24S8 depth (binding 0) and stencil (binding 1)
+//   packed like the EDRAM dump (24-bit depth << 8 | stencil).
+// - XE_RESOLVE_HOST_RT_MSAA: 4x MSAA source (2x isn't supported).
+// The host render target is laid out as in the EDRAM dump: its tile index
+// relative to its base tile, split by its pitch into tile columns and rows of
+// 80x16 samples; 4x MSAA samples are 2x2 per pixel.
+
+#define XE_RESOLVE_HOST_RT
+#include "endian.xesli"
+#include "resolve.xesli"
+
+byte_buffer_align16_wo_declare_xe(xe_resolve_dest, set=0, binding=0, u0, space0)
+
+#ifdef XE_RESOLVE_HOST_RT_DEPTH
+  #ifdef XE_RESOLVE_HOST_RT_MSAA
+    layout(set=1, binding=0) uniform texture2DMS xe_resolve_host_rt;
+    layout(set=1, binding=1) uniform utexture2DMS xe_resolve_host_rt_stencil;
+  #else
+    layout(set=1, binding=0) uniform texture2D xe_resolve_host_rt;
+    layout(set=1, binding=1) uniform utexture2D xe_resolve_host_rt_stencil;
+  #endif
+#elif defined(XE_RESOLVE_HOST_RT_UINT)
+  #ifdef XE_RESOLVE_HOST_RT_MSAA
+    layout(set=1, binding=0) uniform utexture2DMS xe_resolve_host_rt;
+  #else
+    layout(set=1, binding=0) uniform utexture2D xe_resolve_host_rt;
+  #endif
+#else
+  #ifdef XE_RESOLVE_HOST_RT_MSAA
+    layout(set=1, binding=0) uniform texture2DMS xe_resolve_host_rt;
+  #else
+    layout(set=1, binding=0) uniform texture2D xe_resolve_host_rt;
+  #endif
+#endif
+
+uint XeResolveHostRtLoad(ivec2 pixel, int sample_id) {
+  #ifdef XE_RESOLVE_HOST_RT_MSAA
+    #define XE_RESOLVE_HOST_RT_FETCH(texture) texelFetch(texture, pixel, sample_id)
+  #else
+    #define XE_RESOLVE_HOST_RT_FETCH(texture) texelFetch(texture, pixel, 0)
+  #endif
+  #ifdef XE_RESOLVE_HOST_RT_DEPTH
+    // Round to the nearest even like the dump (D24S8).
+    uint depth24 =
+        uint(roundEven(XE_RESOLVE_HOST_RT_FETCH(xe_resolve_host_rt).x * 16777215.0));
+    uint stencil = XE_RESOLVE_HOST_RT_FETCH(xe_resolve_host_rt_stencil).x;
+    return (depth24 << 8u) | (stencil & 0xFFu);
+  #elif defined(XE_RESOLVE_HOST_RT_UINT)
+    return XE_RESOLVE_HOST_RT_FETCH(xe_resolve_host_rt).x;
+  #else
+    uvec4 unorm = uvec4(XE_RESOLVE_HOST_RT_FETCH(xe_resolve_host_rt) * 255.0 + 0.5);
+    return unorm.x | (unorm.y << 8u) | (unorm.z << 16u) | (unorm.w << 24u);
+  #endif
+  #undef XE_RESOLVE_HOST_RT_FETCH
+}
+
+#define LOCAL_SIZE_X_XE 8
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  XE_RESOLVE_PUSH_CONST_BINDING
+  entry_binding_next_xe
+  byte_buffer_wo_binding_xe(xe_resolve_dest, buffer(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
