+  // As XeEdramOffsetBytes, up to the tile index and the sample within it (8
+  // pixels at a multiple of 8 never cross an 80-sample tile column).
+  uint2_xe edram_pixel =
+      uint2_xe(pixel_index.x,
+               max(pixel_index.y, resolve_info.half_pixel_offset_fill_source.y)) +
+      resolve_info.edram_offset_scaled;
+  uint2_xe rt_sample_index =
+      edram_pixel <<
+      uint2_xe(greater_than_equal_xe(
+          uint_x2_xe(resolve_info.edram_msaa_samples),
+          uint2_xe(kXenosMsaaSamples_4X, kXenosMsaaSamples_2X)));
+  rt_sample_index +=
+      (uint_x2_xe(XeResolveFirstSampleIndex(resolve_info.sample_select)) >>
+       uint2_xe(1u, 0u)) & 1u;
+  uint2_xe tile_size_samples = uint2_xe(80u, 16u);
+  uint2_xe tile_offset_xy = rt_sample_index / tile_size_samples;
+  uint tile_index = resolve_info.edram_base_tiles +
+                    tile_offset_xy.y * resolve_info.edram_pitch_tiles +
+                    tile_offset_xy.x;
+  rt_sample_index -= tile_offset_xy * tile_size_samples;
+  // Tile in the host render target (EDRAM addressing is periodic).
+  uint rt_tile_index =
+      (tile_index - push_const_xe(xe_resolve_host_rt_base_tiles)) & 2047u;
+  uint rt_pitch_tiles = push_const_xe(xe_resolve_host_rt_pitch_tiles);
+  uint2_xe source_sample =
+      uint2_xe(rt_tile_index % rt_pitch_tiles, rt_tile_index / rt_pitch_tiles) *
+          tile_size_samples +
+      rt_sample_index;
+  #ifdef XE_RESOLVE_HOST_RT_MSAA
+    ivec2 source_pixel = ivec2(source_sample >> 1u);
+    int source_sample_id =
+        int((source_sample.x & 1u) | ((source_sample.y & 1u) << 1u));
+  #else
+    ivec2 source_pixel = ivec2(source_sample);
+    int source_sample_id = 0;
+  #endif
+  uint4_xe pixels_0123 = uint4_xe(
+      XeResolveHostRtLoad(source_pixel, source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(1, 0), source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(2, 0), source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(3, 0), source_sample_id));
+  uint4_xe pixels_4567 = uint4_xe(
+      XeResolveHostRtLoad(source_pixel + ivec2(4, 0), source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(5, 0), source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(6, 0), source_sample_id),
+      XeResolveHostRtLoad(source_pixel + ivec2(7, 0), source_sample_id));
+  dont_flatten_xe
+  if (pixel_index.x == 0u &&
+      resolve_info.half_pixel_offset_fill_source.x != 0u) {
+    if (resolve_info.half_pixel_offset_fill_source.x >= 2u) {
+      if (resolve_info.half_pixel_offset_fill_source.x >= 3u) {
+        pixels_0123.z = pixels_0123.w;
+      }
+      pixels_0123.y = pixels_0123.z;
+    }
+    pixels_0123.x = pixels_0123.y;
+  }
+  XeResolveSwap8PixelsRedBlue32bpp(resolve_info, pixels_0123, pixels_4567);
+  uint dest_address = XeResolveDestPixelAddress(resolve_info, pixel_index, 2u);
+  byte_buffer_align16_store16_xe(
+      xe_resolve_dest, dest_address,
+      XeEndianSwap32(pixels_0123, resolve_info.dest_endian_128));
+  dest_address += XeResolveLocalXAddressXor(4u, 2u);
+  byte_buffer_align16_store16_xe(
+      xe_resolve_dest, dest_address,
+      XeEndianSwap32(pixels_4567, resolve_info.dest_endian_128));
+}
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/xesl/gpu/shaders/texture_address.xesli b/src/graphics/shaders/xesl/gpu/shaders/texture_address.xesli
