From 6536c99922c26ada6330cd3447922bb4f2dd65a2 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sun, 8 Nov 2026 08:29:23 +0800
Subject: [PATCH 047/108] gpu: vulkan: resolve 32bpp color and D24S8 depth
 straight from the host render target

When one host render target owns the whole resolved EDRAM range, the fast
32bpp resolve now reads that render target in the compute shader instead of
first dumping it to the EDRAM buffer and copying from there: one full-size
read and write less per resolve. Covers k_8_8_8_8 (UNORM view), k_32_FLOAT
(integer view) and kD24S8 depth+stencil, 1x and 4x MSAA, without resolution
scaling; everything else keeps the dump path. direct_host_resolve (default
on) selects it; the earlier stub only re-ran the dump.

Shaders: xesl sources from xenia-canary 65d42843b6 plus
resolve_fast_32bpp_host_rt.xesli, compiled with the NDK's glslc by
scripts/shaders/build_host_rt_resolve_shaders.sh. Also times the EDRAM dump
separately ('D') in the per-operation GPU timing.

Title menu on the Thor (Adreno 740): resolves 0.92 -> 0.21 ms per frame.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index eb181b7..35d02f3 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -247,6 +247,8 @@ class VulkanCommandProcessor : public CommandProcessor {
   void GpuTimingSetPassTag(uint64_t tag) { gpu_timing_pass_tag_ = tag; }
   // Resolve / texture load being recorded, for GPU time by operation and size:
   // kind ('R' or 'T') << 56 | is depth << 55 | format << 48 | width << 24 | height.
+  uint64_t gpu_timing_op_tag() const { return gpu_timing_op_tag_; }
+  void GpuTimingRestoreOpTag(uint64_t tag) { gpu_timing_op_tag_ = tag; }
   void GpuTimingSetOpTag(uint64_t tag) {
     gpu_timing_op_tag_ = tag;
     if (gpu_timing_enabled_) {
diff --git a/include/rex/graphics/vulkan/render_target_cache.h b/include/rex/graphics/vulkan/render_target_cache.h
index 6785596..f412f71 100644
--- a/include/rex/graphics/vulkan/render_target_cache.h
+++ b/include/rex/graphics/vulkan/render_target_cache.h
@@ -805,6 +805,19 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
 
   VkPipeline GetDumpPipeline(DumpPipelineKey key);
   VkPipeline GetDirectResolvePipeline(DirectResolvePipelineKey key);
+  // Resolve read straight from the host render target owning the whole resolved
+  // range (resolve_fast_32bpp_host_rt shaders), skipping the EDRAM dump: fast
+  // (bitwise) 32bpp color copies from 1x or 4x k_8_8_8_8 (UNORM view) or
+  // k_32_FLOAT (integer view) render targets, and 1x or 4x kD24S8 depth, without
+  // resolution scaling.
+  struct DirectHostResolve {
+    VulkanRenderTarget* render_target = nullptr;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    bool is_depth = false;
+  };
+  bool PrepareDirectHostResolve(const draw_util::ResolveInfo& resolve_info,
+                                draw_util::ResolveCopyShaderIndex copy_shader,
+                                bool draw_resolution_scaled, DirectHostResolve& direct_out);
   bool TryResolveCopyDirectly(const draw_util::ResolveInfo& resolve_info,
                               draw_util::ResolveCopyShaderIndex copy_shader,
                               bool draw_resolution_scaled);
@@ -856,6 +869,10 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
   // buffer. VK_NULL_HANDLE if failed to create.
   std::unordered_map<DumpPipelineKey, VkPipeline, DumpPipelineKey::Hasher> dump_pipelines_;
   VkPipelineLayout direct_resolve_pipeline_layout_color_ = VK_NULL_HANDLE;
+  // [4x MSAA][integer view].
+  VkPipeline direct_host_resolve_pipelines_[2][2] = {};
+  // [4x MSAA], kD24S8.
+  VkPipeline direct_host_resolve_depth_pipelines_[2] = {};
   VkPipelineLayout direct_resolve_pipeline_layout_depth_ = VK_NULL_HANDLE;
   std::unordered_map<DirectResolvePipelineKey, VkPipeline, DirectResolvePipelineKey::Hasher>
       direct_resolve_pipelines_;
diff --git a/scripts/shaders/build_host_rt_resolve_shaders.sh b/scripts/shaders/build_host_rt_resolve_shaders.sh
new file mode 100644
index 0000000..66da101
--- /dev/null
+++ b/scripts/shaders/build_host_rt_resolve_shaders.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# Compiles the ReXGlue xesl compute shaders under src/graphics/shaders/xesl to
+# SPIR-V headers in src/graphics/shaders/vulkan_spirv (glslc + spirv-opt from
+# the Android NDK's shader-tools, or from PATH).
+set -euo pipefail
+SDK=$(cd "$(dirname "$0")/../.." && pwd)
+TOOLS=${SHADER_TOOLS:-$(ls -d "${ANDROID_NDK_HOME:-/c/dev/android-sdk/ndk/28.2.13676358}"/shader-tools/*/ 2>/dev/null | head -1)}
+GLSLC="${TOOLS}glslc"; OPT="${TOOLS}spirv-opt"; DIS="${TOOLS}spirv-dis"
+SRC="$SDK/src/graphics/shaders/xesl/gpu/shaders"
+OUT="$SDK/src/graphics/shaders/vulkan_spirv"
+TMP=$(mktemp -d)
+build() {  # name entry defines...
+  local name=$1 entry=$2; shift 2
+  printf '#version 460\n#extension GL_EXT_control_flow_attributes : require\n#extension GL_EXT_samplerless_texture_functions : require\n#extension GL_GOOGLE_include_directive : require\n#include "%s"\n' "$entry" > "$TMP/$name.comp"
+  "$GLSLC" -fshader-stage=compute --target-env=vulkan1.0 -DSHADING_LANGUAGE_GLSL_XE=1 "$@" \
+    -I"$SRC" "$TMP/$name.comp" -o "$TMP/$name.glslc.spv"
+  "$OPT" -O "$TMP/$name.glslc.spv" -o "$TMP/$name.spv"
+  "$DIS" "$TMP/$name.spv" -o "$TMP/$name.txt"
+  python -I - "$TMP/$name.spv" "$TMP/$name.txt" "$OUT/${name}.h" "$name" <<'PY'
+import sys, struct
+spv, txt, out, name = sys.argv[1:5]
+data = open(spv, 'rb').read()
+words = struct.unpack('<%dI' % (len(data) // 4), data)
+with open(out, 'w', newline='\n') as f:
+    f.write('// Generated by scripts/shaders/build_host_rt_resolve_shaders.sh.\n#if 0\n')
+    f.write(open(txt).read())
+    f.write('#endif\n\nconst uint32_t %s[] = {\n' % name)
+    for i in range(0, len(words), 6):
+        f.write('    ' + ', '.join('0x%08X' % w for w in words[i:i + 6]) + ',\n')
+    f.write('};\n')
+PY
+  echo "$name: $(( $(stat -c %s "$TMP/$name.spv") )) bytes"
+}
+E=resolve_fast_32bpp_host_rt.xesli
+build resolve_fast_32bpp_host_rt_1x_unorm8_cs $E
+build resolve_fast_32bpp_host_rt_1x_uint_cs $E -DXE_RESOLVE_HOST_RT_UINT
+build resolve_fast_32bpp_host_rt_4x_unorm8_cs $E -DXE_RESOLVE_HOST_RT_MSAA
+build resolve_fast_32bpp_host_rt_4x_uint_cs $E -DXE_RESOLVE_HOST_RT_UINT -DXE_RESOLVE_HOST_RT_MSAA
+build resolve_fast_32bpp_host_rt_1x_d24s8_cs $E -DXE_RESOLVE_HOST_RT_DEPTH
+build resolve_fast_32bpp_host_rt_4x_d24s8_cs $E -DXE_RESOLVE_HOST_RT_DEPTH -DXE_RESOLVE_HOST_RT_MSAA
+rm -rf "$TMP"
