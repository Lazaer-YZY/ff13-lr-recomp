+bool VulkanRenderTargetCache::PrepareDirectHostResolve(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    bool draw_resolution_scaled, DirectHostResolve& direct_out) {
+  bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  if (draw_resolution_scaled || edram_info.format_is_64bpp ||
+      !xenos::IsSingleCopySampleSelected(
+          resolve_info.copy_dest_coordinate_info.copy_sample_select)) {
+    return false;
+  }
+  xenos::MsaaSamples msaa_samples = edram_info.msaa_samples;
+  bool msaa_4x;
+  if (copy_shader == draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA &&
+      msaa_samples == xenos::MsaaSamples::k1X) {
+    msaa_4x = false;
+  } else if (copy_shader == draw_util::ResolveCopyShaderIndex::kFast32bpp4xMSAA &&
+             msaa_samples == xenos::MsaaSamples::k4X) {
+    msaa_4x = true;
+  } else {
+    return false;
+  }
+  // One render target must own the whole resolved range, otherwise the EDRAM
+  // buffer holds data for the rest.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return false;
+  }
+  const ResolveCopyDumpRectangle& rectangle = dump_rectangles_.front();
+  if (!rectangle.render_target || rectangle.row_first != 0 || rectangle.rows != dump_rows ||
+      rectangle.row_first_start != 0 || rectangle.row_last_end != dump_row_length_used) {
+    return false;
+  }
+  auto* render_target = static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  RenderTargetKey key = render_target->key();
+  if (key.is_depth != is_depth || key.msaa_samples != msaa_samples || !key.pitch_tiles_at_32bpp) {
+    return false;
+  }
+  if (is_depth) {
+    if (key.GetDepthFormat() != xenos::DepthRenderTargetFormat::kD24S8 ||
+        edram_info.format != uint32_t(xenos::DepthRenderTargetFormat::kD24S8)) {
+      return false;
+    }
+    VkPipeline depth_pipeline = direct_host_resolve_depth_pipelines_[msaa_4x];
+    if (depth_pipeline == VK_NULL_HANDLE) {
+      return false;
+    }
+    direct_out.render_target = render_target;
+    direct_out.pipeline = depth_pipeline;
+    direct_out.is_depth = true;
+    return true;
+  }
+  if (uint32_t(key.GetColorFormat()) != edram_info.format) {
+    return false;
+  }
+  bool is_uint = false;
+  switch (key.GetColorFormat()) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+      GetColorOwnershipTransferVulkanFormat(key.GetColorFormat(), key.msaa_samples, &is_uint);
+      if (is_uint) {
+        return false;
+      }
+      break;
+    case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+      GetColorOwnershipTransferVulkanFormat(key.GetColorFormat(), key.msaa_samples, &is_uint);
+      if (!is_uint) {
+        return false;
+      }
+      break;
+    default:
+      return false;
+  }
+  VkPipeline pipeline = direct_host_resolve_pipelines_[msaa_4x][is_uint];
+  if (pipeline == VK_NULL_HANDLE) {
+    return false;
+  }
+  direct_out.render_target = render_target;
+  direct_out.pipeline = pipeline;
+  direct_out.is_depth = false;
+  return true;
+}
