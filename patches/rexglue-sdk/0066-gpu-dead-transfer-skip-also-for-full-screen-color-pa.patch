+  bool EstimateRectangleCoverage(const Shader& vertex_shader, int32_t bounds_left,
+                                 int32_t bounds_top, int32_t bounds_right, int32_t bounds_bottom,
+                                 int32_t& left_out, int32_t& top_out, int32_t& right_out,
+                                 int32_t& bottom_out, uint32_t* reject_out = nullptr);
 
