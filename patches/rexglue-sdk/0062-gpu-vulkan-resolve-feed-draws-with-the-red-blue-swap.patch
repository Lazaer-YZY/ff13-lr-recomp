diff --git a/include/rex/graphics/vulkan/render_target_cache.h b/include/rex/graphics/vulkan/render_target_cache.h
index f412f71..7bdc1b6 100644
--- a/include/rex/graphics/vulkan/render_target_cache.h
+++ b/include/rex/graphics/vulkan/render_target_cache.h
@@ -354,8 +354,34 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
     VkPipelineStageFlags current_stage_mask() const { return current_stage_mask_; }
     VkAccessFlags current_access_mask() const { return current_access_mask_; }
     VkImageLayout current_layout() const { return current_layout_; }
+    // Source scope of a barrier to dst_stage_mask. Besides the current usage,
+    // it includes the last write to the image if that write hasn't been made
+    // visible to dst_stage_mask by an earlier barrier yet. Vulkan allows relying
+    // on a dependency chain instead (write -> barrier to compute -> barrier from
+    // compute to fragment), but the Adreno driver doesn't honour such chains:
+    // fragment shaders reading a render target after a compute resolve read it
+    // saw partly stale contents (black blocks and speckle).
+    VkPipelineStageFlags src_stage_mask(VkPipelineStageFlags dst_stage_mask) const {
+      return current_stage_mask_ |
+             ((dst_stage_mask & ~write_visible_stage_mask_) ? last_write_stage_mask_ : 0);
+    }
+    VkAccessFlags src_access_mask(VkPipelineStageFlags dst_stage_mask) const {
+      return current_access_mask_ |
+             ((dst_stage_mask & ~write_visible_stage_mask_) ? last_write_access_mask_ : 0);
+    }
     void SetUsage(VkPipelineStageFlags stage_mask, VkAccessFlags access_mask,
                   VkImageLayout layout) {
+      constexpr VkAccessFlags kWriteAccessMask =
+          VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+          VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+          VK_ACCESS_HOST_WRITE_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+      if (access_mask & kWriteAccessMask) {
+        last_write_stage_mask_ = stage_mask;
+        last_write_access_mask_ = access_mask & kWriteAccessMask;
+        write_visible_stage_mask_ = stage_mask;
+      } else {
+        write_visible_stage_mask_ |= stage_mask;
+      }
       current_stage_mask_ = stage_mask;
       current_access_mask_ = access_mask;
       current_layout_ = layout;
@@ -385,6 +411,10 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
     VkPipelineStageFlags current_stage_mask_ = 0;
     VkAccessFlags current_access_mask_ = 0;
     VkImageLayout current_layout_ = VK_IMAGE_LAYOUT_UNDEFINED;
+    // The last write and the stages it has been made visible to (src_stage_mask).
+    VkPipelineStageFlags last_write_stage_mask_ = 0;
+    VkAccessFlags last_write_access_mask_ = 0;
+    VkPipelineStageFlags write_visible_stage_mask_ = 0;
 
