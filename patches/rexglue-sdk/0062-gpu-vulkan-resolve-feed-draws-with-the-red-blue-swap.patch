diff --git a/scripts/shaders/spv_to_header.py b/scripts/shaders/spv_to_header.py
new file mode 100644
index 0000000..89d94d6
--- /dev/null
+++ b/scripts/shaders/spv_to_header.py
@@ -0,0 +1,16 @@
+"""Writes a SPIR-V binary as a C++ header (uint32_t array) with its disassembly in a comment.
+Usage: python -I spv_to_header.py SPV DISASM_TXT OUT_H NAME
+"""
+import struct
+import sys
+
+spv, txt, out, name = sys.argv[1:5]
+data = open(spv, 'rb').read()
+words = struct.unpack('<%dI' % (len(data) // 4), data)
+with open(out, 'w', newline='\n') as f:
+    f.write('// Generated by scripts/shaders/build_host_rt_resolve_shaders.sh.\n#if 0\n')
+    f.write(open(txt).read())
+    f.write('#endif\n\nconst uint32_t %s[] = {\n' % name)
+    for i in range(0, len(words), 6):
+        f.write('    ' + ', '.join('0x%08X' % w for w in words[i:i + 6]) + ',\n')
+    f.write('};\n')
diff --git a/src/graphics/shaders/glsl/resolve_feed.frag b/src/graphics/shaders/glsl/resolve_feed.frag
new file mode 100644
index 0000000..1d9a40c
--- /dev/null
+++ b/src/graphics/shaders/glsl/resolve_feed.frag
@@ -0,0 +1,19 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+// Resolve feed: copies a render target region into the cached texture that
+// samples the resolve destination. flags bit 0: swap red and blue
+// (copy_dest_swap); bit 1: write solid magenta (vulkan_resolve_feed_debug).
+layout(set = 0, binding = 0) uniform texture2D xe_feed_source;
+layout(push_constant) uniform XeFeedConstants {
+  ivec2 source_offset;
+  uint flags;
+} xe_feed;
+layout(location = 0) out vec4 xe_feed_color;
+void main() {
+  if ((xe_feed.flags & 2u) != 0u) {
+    xe_feed_color = vec4(1.0, 0.0, 1.0, 1.0);
+    return;
+  }
+  vec4 color = texelFetch(xe_feed_source, ivec2(gl_FragCoord.xy) + xe_feed.source_offset, 0);
+  xe_feed_color = (xe_feed.flags & 1u) != 0u ? color.bgra : color;
+}
diff --git a/src/graphics/shaders/glsl/resolve_feed.vert b/src/graphics/shaders/glsl/resolve_feed.vert
new file mode 100644
index 0000000..d2b75e7
--- /dev/null
+++ b/src/graphics/shaders/glsl/resolve_feed.vert
@@ -0,0 +1,7 @@
+#version 450
+// ReXGlue resolve feeding: a triangle covering the viewport (the destination
+// rectangle in the texture).
+void main() {
+  vec2 position = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+  gl_Position = vec4(position * 2.0 - 1.0, 0.0, 1.0);
+}
