From 4dc618b3da97d736bb7fc49699cf006c42938a59 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Thu, 12 Nov 2026 23:57:39 +0800
Subject: [PATCH 107/108] gpu: memexport watches - skip repeated ranges
 (generation), block-skip watched pages, counters; arm64 counter clock for the
 frame timers


diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 406d720..254836e 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -189,6 +189,18 @@ class SharedMemory {
   std::vector<uint64_t> system_page_flags_valid_and_gpu_written_;
   uint32_t num_system_page_flags_ = 0;
 
+  // Bumped whenever watches are added or validity / page protection may have changed outside
+  // RangeWrittenByGpu (CPU writes, invalidations, cache clears). RangeWrittenByGpu skips a range
+  // it already handled at the same generation: memexport draws re-declare the same destination
+  // after every draw (Lightning Returns' battle starts: ~10,000 draws exporting 32 MB each).
+  uint64_t watch_generation_ = 1;
+  struct RecentGpuWrite {
+    uint32_t start = 0, length = 0;
+    uint64_t generation = 0;
+  };
+  RecentGpuWrite recent_gpu_writes_[4];
+  uint32_t recent_gpu_write_next_ = 0;
+
   static std::pair<uint32_t, uint32_t> MemoryInvalidationCallbackThunk(
       void* context_ptr, uint32_t physical_address_start, uint32_t length, bool exact_range);
 
diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 72292e1..2c93662 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -389,8 +389,8 @@ class VulkanCommandProcessor : public CommandProcessor {
