From 0745fbb0bc4c96e514e43671777998cd3c70a7c0 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sat, 7 Nov 2026 14:16:53 +0800
Subject: [PATCH 004/108] ui(android): add AndroidNativeWindowSurface and SDL
 native window lookup

surface_android.h/.cpp wrap the ANativeWindow from SDL_PROP_WINDOW_ANDROID_
WINDOW_POINTER; VulkanPresenter already creates the VkSurfaceKHR from it via
vkCreateAndroidSurfaceKHR. rexui drops the xcb/wayland pkg-config path on
Android and links libandroid.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/include/rex/ui/surface_android.h b/include/rex/ui/surface_android.h
new file mode 100644
index 0000000..5693321
--- /dev/null
+++ b/include/rex/ui/surface_android.h
@@ -0,0 +1,36 @@
+#pragma once
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2021 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#include <rex/ui/surface.h>
+
+struct ANativeWindow;
+
+namespace rex {
+namespace ui {
+
+// Wraps the ANativeWindow owned by SDL's Android backend (SDLActivity). The
+// presenter creates the VkSurfaceKHR itself via vkCreateAndroidSurfaceKHR.
+class AndroidNativeWindowSurface final : public Surface {
+ public:
+  explicit AndroidNativeWindowSurface(ANativeWindow* window) : window_(window) {}
+  TypeIndex GetType() const override { return kTypeIndex_AndroidNativeWindow; }
+  ANativeWindow* window() const { return window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override;
+
+ private:
+  ANativeWindow* window_;
+};
+
+}  // namespace ui
+}  // namespace rex
