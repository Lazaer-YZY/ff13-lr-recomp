+void VulkanRenderTargetCache::OnSharedMemoryRangesRequested(
+    const std::pair<uint32_t, uint32_t>* ranges, size_t count) {
+  if (pending_resolve_dumps_.empty()) {
+    return;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    FlushPendingResolveDumps(ranges[i].first, ranges[i].second, "memory requested");
+  }
+}
+
+void VulkanRenderTargetCache::FlushPendingResolveDumps(uint32_t start, uint32_t length,
+                                                       const char* reason) {
+  if (pending_resolve_dumps_.empty() || !length) {
+    return;
+  }
+  uint64_t end = uint64_t(start) + length;
+  // Take the intersecting dumps out first: recording one must not see the list
+  // change under it.
+  std::vector<PendingResolveDump> flushing;
+  for (size_t i = 0; i < pending_resolve_dumps_.size();) {
+    const PendingResolveDump& dump = pending_resolve_dumps_[i];
+    if (uint64_t(dump.dest_start) < end && uint64_t(dump.dest_start) + dump.dest_length > start) {
+      flushing.push_back(dump);
+      pending_resolve_dumps_.erase(pending_resolve_dumps_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+  for (const PendingResolveDump& dump : flushing) {
+    PerformPendingResolveDump(dump, reason);
+  }
+}
+
+void VulkanRenderTargetCache::DropPendingResolveDumpsCoveredBy(uint32_t start, uint32_t length) {
+  if (pending_resolve_dumps_.empty() || !length) {
+    return;
+  }
+  uint64_t end = uint64_t(start) + length;
+  for (size_t i = 0; i < pending_resolve_dumps_.size();) {
+    PendingResolveDump& dump = pending_resolve_dumps_[i];
+    if (dump.dest_start >= start && uint64_t(dump.dest_start) + dump.dest_length <= end) {
+      dump.texture->RemovePendingGpuDump();
+      ++lazy_dumps_dropped_;
+      pending_resolve_dumps_.erase(pending_resolve_dumps_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void VulkanRenderTargetCache::DropAllPendingResolveDumps(const char* reason) {
+  if (pending_resolve_dumps_.empty()) {
+    return;
+  }
+  REXGPU_INFO("VulkanRenderTargetCache: {} pending lazy resolve dumps dropped ({})",
+              pending_resolve_dumps_.size(), reason);
+  for (PendingResolveDump& dump : pending_resolve_dumps_) {
+    dump.texture->RemovePendingGpuDump();
+    ++lazy_dumps_lost_;
+  }
+  pending_resolve_dumps_.clear();
+}
+
+void VulkanRenderTargetCache::OnTextureDestroyed(VulkanTextureCache::VulkanTexture* texture) {
+  for (size_t i = 0; i < pending_resolve_dumps_.size();) {
+    const PendingResolveDump& dump = pending_resolve_dumps_[i];
+    if (dump.texture == texture) {
+      REXGPU_WARN("VulkanRenderTargetCache: fed texture destroyed with a pending lazy resolve "
+                  "dump - guest memory @{:08X} ({:X} bytes) keeps older data",
+                  dump.dest_start, dump.dest_length);
+      ++lazy_dumps_lost_;
+      pending_resolve_dumps_.erase(pending_resolve_dumps_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+  auto source_it = lazy_dump_sources_.find(texture);
+  if (source_it != lazy_dump_sources_.end()) {
+    if (descriptor_set_pool_sampled_image_) {
+      for (size_t index : source_it->second.descriptor_index) {
+        if (index != SIZE_MAX) {
+          descriptor_set_pool_sampled_image_->Free(index);
+        }
+      }
+    }
+    lazy_dump_sources_.erase(source_it);
+  }
+}
+
+void VulkanRenderTargetCache::LogAndResetLazyDumpStats(double frames) {
+  if (lazy_dumps_deferred_ || lazy_dumps_flushed_ || lazy_dumps_dropped_ || lazy_dumps_lost_) {
+    REXGPU_INFO("GPU lazy resolve dumps per frame: {:.2f} deferred, {:.3f} written later, {:.2f} "
+                "overwritten before being written, {} lost; {} pending",
+                double(lazy_dumps_deferred_) / frames, double(lazy_dumps_flushed_) / frames,
+                double(lazy_dumps_dropped_) / frames, lazy_dumps_lost_,
+                pending_resolve_dumps_.size());
+  }
+  lazy_dumps_deferred_ = 0;
+  lazy_dumps_flushed_ = 0;
+  lazy_dumps_dropped_ = 0;
+  lazy_dumps_lost_ = 0;
+}
+
+void VulkanRenderTargetCache::PerformPendingResolveDump(const PendingResolveDump& dump,
+                                                        const char* reason) {
+  dump.texture->RemovePendingGpuDump();
+  auto lost = [&](const char* what) {
+    ++lazy_dumps_lost_;
+    REXGPU_WARN("VulkanRenderTargetCache: lazy resolve dump of @{:08X} not recorded ({}, {})",
+                dump.dest_start, what, reason);
+  };
+  if (!lazy_shared_memory_ || !lazy_texture_cache_ || !command_processor_.submission_open() ||
+      direct_resolve_pipeline_layout_color_ == VK_NULL_HANDLE ||
+      dump.pipeline == VK_NULL_HANDLE) {
+    lost("no submission");
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+
+  // The fed texture as the compute shader's source. The feed applied the
+  // red/blue swap; a swapped view undoes it so the shader swaps again like the
+  // eager dump does.
+  LazyDumpSource& source = lazy_dump_sources_[dump.texture];
+  size_t& source_index = source.descriptor_index[dump.swap_red_blue ? 1 : 0];
+  if (source_index == SIZE_MAX) {
+    uint32_t source_swizzle =
+        dump.swap_red_blue
+            ? (uint32_t(xenos::XE_GPU_TEXTURE_SWIZZLE_B) | uint32_t(xenos::XE_GPU_TEXTURE_SWIZZLE_G) << 3 |
+               uint32_t(xenos::XE_GPU_TEXTURE_SWIZZLE_R) << 6 | uint32_t(xenos::XE_GPU_TEXTURE_SWIZZLE_A) << 9)
+            : uint32_t(xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA);
+    VkImageView source_view = dump.texture->GetView(false, source_swizzle, false);
+    if (source_view == VK_NULL_HANDLE) {
+      lost("no texture view");
+      return;
+    }
+    source_index = descriptor_set_pool_sampled_image_->Allocate();
+    if (source_index == SIZE_MAX) {
+      lost("no descriptor");
+      return;
+    }
+    VkDescriptorImageInfo source_image_info;
+    source_image_info.sampler = VK_NULL_HANDLE;
+    source_image_info.imageView = source_view;
+    source_image_info.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    VkWriteDescriptorSet source_write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    source_write.dstSet = descriptor_set_pool_sampled_image_->Get(source_index);
+    source_write.dstBinding = 0;
+    source_write.dstArrayElement = 0;
+    source_write.descriptorCount = 1;
+    source_write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    source_write.pImageInfo = &source_image_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &source_write, 0, nullptr);
+  }
+
+  VkDescriptorSet descriptor_set_dest = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (descriptor_set_dest == VK_NULL_HANDLE) {
+    lost("no destination descriptor");
+    return;
+  }
+  VkDescriptorBufferInfo dest_buffer_info;
+  dest_buffer_info.buffer = lazy_shared_memory_->buffer();
+  dest_buffer_info.offset = dump.dest_base;
+  dest_buffer_info.range = dump.dest_range_length;
+  VkWriteDescriptorSet dest_write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  dest_write.dstSet = descriptor_set_dest;
+  dest_write.dstBinding = 0;
+  dest_write.dstArrayElement = 0;
+  dest_write.descriptorCount = 1;
+  dest_write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  dest_write.pBufferInfo = &dest_buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &dest_write, 0, nullptr);
+
+  lazy_shared_memory_->Use(VulkanSharedMemory::Usage::kComputeWrite,
+                           std::make_pair(dump.dest_start, dump.dest_length));
+  lazy_texture_cache_->TransitionTextureForComputeRead(*dump.texture);
+  command_processor_.BindExternalComputePipeline(dump.pipeline);
+  VkDescriptorSet descriptor_sets[] = {descriptor_set_dest,
+                                       descriptor_set_pool_sampled_image_->Get(source_index)};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         direct_resolve_pipeline_layout_color_, 0,
+                                         uint32_t(rex::countof(descriptor_sets)), descriptor_sets,
+                                         0, nullptr);
+  DirectResolvePushConstants constants = dump.constants;
+  constants.resolve.dest_base -= dump.dest_base;
+  command_buffer.CmdVkPushConstants(direct_resolve_pipeline_layout_color_,
+                                    VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                    &constants);
+  command_processor_.GpuTimingRestoreOpTag(dump.op_tag);
+  command_processor_.SubmitBarriers(true);
+  command_processor_.GpuTimingMark(VulkanCommandProcessor::GpuTimingCategory::kResolves);
+  command_buffer.CmdVkDispatch(dump.group_count_x, dump.group_count_y, 1);
+  command_processor_.GpuTrace("Rlazy");
+  ++lazy_dumps_flushed_;
+  if (lazy_dump_flush_logs_ < 40) {
+    ++lazy_dump_flush_logs_;
+    REXGPU_INFO("Lazy resolve dump written: @{:08X} ({:X} bytes) because {}", dump.dest_start,
+                dump.dest_length, reason);
+  }
+}
