+// Vertex shader memexport draws left out on a device without vertexPipelineStoresAndAtomics (only with
+// vulkan_require_vertex_pipeline_stores_and_atomics off, for testing). Lightning Returns moves its GPU heap with such
+// draws, so a test must be able to tell how many draws and which vertex shaders it lost: the reason once, then the
+// running counts at most every 10 s (checked at each left-out draw and each swap). Command processor thread only.
+struct SkippedVertexMemexportLog {
+  uint64_t draws = 0;
+  uint64_t draws_reported = 0;
+  std::unordered_set<uint64_t> shaders;
+  std::vector<uint64_t> shaders_new;
+  std::chrono::steady_clock::time_point last_report;
+
+  void OnSkip(uint64_t vertex_shader_hash) {
+    if (shaders.insert(vertex_shader_hash).second) {
+      shaders_new.push_back(vertex_shader_hash);
+    }
+    if (!draws++) {
+      REXGPU_WARN(
+          "Vertex shader memexport draws left out: no vertexPipelineStoresAndAtomics on this device "
+          "(vulkan_require_vertex_pipeline_stores_and_atomics=false); the data they export is lost. First vertex "
+          "shader {:016X}; counts follow at most every 10 s",
+          vertex_shader_hash);
+      draws_reported = draws;
+      shaders_new.clear();
+      last_report = std::chrono::steady_clock::now();
+      return;
+    }
+    ReportIfDue();
+  }
+
+  void ReportIfDue() {
+    if (draws == draws_reported) {
+      return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_report < std::chrono::seconds(10)) {
+      return;
+    }
+    std::string new_hashes;
+    for (size_t i = 0; i < shaders_new.size() && i < 16; ++i) {
+      new_hashes += fmt::format(" {:016X}", shaders_new[i]);
+    }
+    if (shaders_new.size() > 16) {
+      new_hashes += fmt::format(" (+{} more)", shaders_new.size() - 16);
+    }
+    REXGPU_WARN(
+        "Vertex shader memexport draws left out so far: {} draws, {} distinct vertex shaders; new vertex shaders "
+        "since the last count:{}",
+        draws, shaders.size(), new_hashes.empty() ? std::string(" none") : new_hashes);
+    draws_reported = draws;
+    shaders_new.clear();
+    last_report = now;
+  }
+};
+SkippedVertexMemexportLog skipped_vertex_memexport_log;
+
 }  // namespace
 
