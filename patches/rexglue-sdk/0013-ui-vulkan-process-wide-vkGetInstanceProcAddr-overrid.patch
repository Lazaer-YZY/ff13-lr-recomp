From 4f65b2cc9aa5223cc0e0a82e947d1d674be89c36 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sat, 7 Nov 2026 14:34:33 +0800
Subject: [PATCH 013/108] ui(vulkan): process-wide vkGetInstanceProcAddr
 override

New rex::ui::vulkan::SetInstanceProcAddrOverride(void*) /
GetInstanceProcAddrOverride() (include/rex/ui/vulkan/loader_override.h). The
storage is an atomic in src/ui/vulkan/loader_override.cpp, part of the rexui
OBJECT library, which is linked only into librexruntime (enforced by
rexglue_link_audit), so the game and the GPU plugin share one copy through the
exported accessors. It is compiled regardless of REXGLUE_USE_VULKAN.

When set, VulkanInstance::Create skips loading the system Vulkan loader, uses
the override as vkGetInstanceProcAddr for the global functions and resolves
vkDestroyInstance from the created instance. Intended for Turnip via
libadrenotools on Android; never set on desktop.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/include/rex/ui/vulkan/loader_override.h b/include/rex/ui/vulkan/loader_override.h
new file mode 100644
index 0000000..47157da
--- /dev/null
+++ b/include/rex/ui/vulkan/loader_override.h
@@ -0,0 +1,24 @@
+#pragma once
+/**
+ * @file        rex/ui/vulkan/loader_override.h
+ * @brief       Process-wide override of the Vulkan loader entry point
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+namespace rex::ui::vulkan {
+
+// Hands the runtime a custom vkGetInstanceProcAddr (e.g. a Turnip driver
+// loaded through libadrenotools on Android). Call before the GPU plugin
+// creates its VulkanInstance; once set, VulkanInstance::Create does not load
+// the system Vulkan loader and resolves everything through this function.
+// Pass nullptr to clear. Plain void* so callers need no Vulkan headers.
+//
+// The storage lives once in librexruntime (rexui objects are only linked into
+// rexruntime; see cmake/rexglue_link_audit.cmake), so the game library and
+// the GPU plugin observe the same value through these exported accessors.
+void SetInstanceProcAddrOverride(void* pfn_vkGetInstanceProcAddr);
+void* GetInstanceProcAddrOverride();
+
+}  // namespace rex::ui::vulkan
