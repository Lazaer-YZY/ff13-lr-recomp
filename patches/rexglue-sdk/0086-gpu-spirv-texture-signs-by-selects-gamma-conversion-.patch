+          // per-component OpSwitch below is lowered by Mesa to ifs that it flattens, so the gamma
+          // conversion of every fetched component ran (and was discarded) for every texture.
+          spv::Id component_unsigned[4] = {};
+          spv::Id component_is_gamma[4] = {};
+          spv::Id any_gamma = spv::NoResult;
+          uint32_t result_remaining_components = used_result_nonzero_components;
+          uint32_t result_component_index;
+          while (rex::bit_scan_forward(result_remaining_components, &result_component_index)) {
+            result_remaining_components &= ~(UINT32_C(1) << result_component_index);
+            spv::Id sign = swizzled_signs[result_component_index];
+            spv::Id component_value =
+                features_.image_view_format_swizzle
+                    ? builder_->createCompositeExtract(sample_result_unsigned, type_float_,
+                                                       result_component_index)
+                    : result[result_component_index];
+            component_unsigned[result_component_index] = component_value;
+            if (features_.image_view_format_swizzle) {
+              component_value = builder_->createTriOp(
+                  spv::OpSelect, type_float_,
+                  builder_->createBinOp(spv::OpIEqual, type_bool_, sign,
+                                        builder_->makeUintConstant(
+                                            uint32_t(xenos::TextureSign::kSigned))),
+                  builder_->createCompositeExtract(sample_result_signed, type_float_,
+                                                   result_component_index),
+                  component_value);
+            }
+            spv::Id component_biased = builder_->createNoContractionBinOp(
+                spv::OpFAdd, type_float_,
+                builder_->createNoContractionBinOp(spv::OpFMul, type_float_,
+                                                   component_unsigned[result_component_index],
+                                                   const_float_2),
+                const_float_minus_1);
+            component_value = builder_->createTriOp(
+                spv::OpSelect, type_float_,
+                builder_->createBinOp(
+                    spv::OpIEqual, type_bool_, sign,
+                    builder_->makeUintConstant(uint32_t(xenos::TextureSign::kUnsignedBiased))),
+                component_biased, component_value);
+            result[result_component_index] = component_value;
+            spv::Id is_gamma = builder_->createBinOp(
+                spv::OpIEqual, type_bool_, sign,
+                builder_->makeUintConstant(uint32_t(xenos::TextureSign::kGamma)));
+            component_is_gamma[result_component_index] = is_gamma;
+            any_gamma = any_gamma != spv::NoResult
+                            ? builder_->createBinOp(spv::OpLogicalOr, type_bool_, any_gamma,
+                                                    is_gamma)
+                            : is_gamma;
+          }
+          if (any_gamma != spv::NoResult) {
+            spv::Id gamma_results[4] = {};
+            SpirvBuilder::IfBuilder if_any_gamma(any_gamma, spv::SelectionControlDontFlattenMask,
+                                                 *builder_);
+            {
+              uint32_t gamma_remaining_components = used_result_nonzero_components;
+              uint32_t gamma_component_index;
+              while (rex::bit_scan_forward(gamma_remaining_components, &gamma_component_index)) {
+                gamma_remaining_components &= ~(UINT32_C(1) << gamma_component_index);
+                spv::Id gamma_value =
+                    PWLGammaToLinear(component_unsigned[gamma_component_index], false);
+                gamma_results[gamma_component_index] = builder_->createTriOp(
+                    spv::OpSelect, type_float_, component_is_gamma[gamma_component_index],
+                    gamma_value, result[gamma_component_index]);
+              }
+            }
+            if_any_gamma.makeEndIf();
