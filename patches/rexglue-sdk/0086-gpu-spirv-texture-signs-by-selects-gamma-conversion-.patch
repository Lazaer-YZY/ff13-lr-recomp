From 3577e3db27a0c595af9f88962a9abb5f7f8b158d Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Mon, 9 Nov 2026 16:55:04 +0800
Subject: [PATCH 086/108] gpu: spirv: texture signs by selects, gamma
 conversion in one uniform branch (default on); vertex-only multiply switch

The per-component OpSwitch on the texture sign is lowered by Mesa to ifs that it
flattens, so the piecewise-linear gamma conversion of every fetched component ran
and was discarded for every texture. spirv_texture_sign_branch (on): signed and
biased components by selects, the gamma conversion inside one uniform
DontFlatten branch taken when any used component is gamma. Same results. Idea
from Xendroid+ (phforner0/Xendroid-Plus, spirv_texture_sign_branch), written anew.
Thor (Turnip, 60 fps mode, Ark screen view): 21.3 -> 18.8 ms per frame, GPU work
13.84 -> 12.09 Mcycles per frame, same image.

vulkan_shader_xenos_multiply_vertex (on): off drops the 0 * x = 0 emulation in
vertex shaders only (for A/B).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/graphics/pipeline/shader/spirv_translator_alu.cpp b/src/graphics/pipeline/shader/spirv_translator_alu.cpp
index efc2365..667ab80 100644
--- a/src/graphics/pipeline/shader/spirv_translator_alu.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator_alu.cpp
@@ -26,13 +26,19 @@ REXCVAR_DEFINE_BOOL(vulkan_shader_xenos_multiply, true, "GPU/Vulkan",
                     "and NaN) in translated shaders. Turning it off saves ALU work but may "
                     "produce NaN / infinity where the guest got zero. Experimental; takes effect "
                     "for shaders translated afterwards.");
+REXCVAR_DEFINE_BOOL(vulkan_shader_xenos_multiply_vertex, true, "GPU/Vulkan",
+                    "vulkan_shader_xenos_multiply for vertex shaders. Off: vertex shaders multiply "
+                    "with host rules (for finite operands only the sign of a zero product may "
+                    "differ, so positions computed by different shaders still match; Xendroid+ "
+                    "measured a third of the main-pass vertex shader instructions saved).");
 
 namespace rex::graphics {
 
 spv::Id SpirvShaderTranslator::ZeroIfAnyOperandIsZero(spv::Id value, spv::Id operand_0_abs,
                                                       spv::Id operand_1_abs) {
   EnsureBuildPointAvailable();
-  if (!REXCVAR_GET(vulkan_shader_xenos_multiply)) {
+  if (!REXCVAR_GET(vulkan_shader_xenos_multiply) ||
+      (is_vertex_shader() && !REXCVAR_GET(vulkan_shader_xenos_multiply_vertex))) {
     return value;
   }
   int num_components = builder_->getNumComponents(value);
