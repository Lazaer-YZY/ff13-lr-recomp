From dab2bd2b4f91f6728a71ea396fdb4982d0d2cc95 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Mon, 9 Nov 2026 12:22:01 +0800
Subject: [PATCH 081/108] gpu: vulkan_gpu_trace_frames_window cvar; optional
 eager guest-sampled texture transitions (off)


diff --git a/include/rex/graphics/vulkan/texture_cache.h b/include/rex/graphics/vulkan/texture_cache.h
index 9635c6e..c0aa156 100644
--- a/include/rex/graphics/vulkan/texture_cache.h
+++ b/include/rex/graphics/vulkan/texture_cache.h
@@ -367,6 +367,10 @@ class VulkanTextureCache final : public TextureCache {
   // Lazy resolve dumps: barrier (pushed, not submitted) for a compute shader
   // reading the texture; it stays readable by guest shaders.
   void TransitionTextureForComputeRead(VulkanTexture& texture);
+  // Right after a load or a feed (outside any render pass): the barrier to the layout guest
+  // shaders sample, so binding the texture in a later draw doesn't end the pass it is in
+  // (vulkan_texture_eager_transition).
+  void TransitionTextureToGuestSampled(VulkanTexture& texture);
 
  private:
 
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index cc3ce1c..6695d13 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -105,6 +105,9 @@ REXCVAR_DEFINE_BOOL(vulkan_lr_skip_battle_grey, false, "GPU/Vulkan",
 REXCVAR_DEFINE_BOOL(vulkan_attachment_barrier_between_passes, false, "GPU",
                     "Attachment write -> attachment read/write barrier between render "
                     "target cache render pass instances.");
+REXCVAR_DEFINE_UINT32(vulkan_gpu_trace_frames_window, 4, "GPU",
+                      "The 10-second GPU timing window (from start) at which vulkan_gpu_trace_frames "
+                      "traces; 4 = about 40 s after start.");
 REXCVAR_DEFINE_UINT32(vulkan_gpu_trace_frames, 0, "GPU",
                       "Trace this many consecutive frames (vulkan_gpu_timing), once, from "
                       "about 40 s after start.");
@@ -3914,7 +3917,8 @@ void VulkanCommandProcessor::GpuTimingOnSwap() {
     gpu_trace_armed_ = REXCVAR_GET(vulkan_gpu_trace_frame);
     // vulkan_gpu_trace_frames: trace that many consecutive frames once, from
     // the 4th 10-second window (the title menu is up by then).
-    if (REXCVAR_GET(vulkan_gpu_trace_frames) && ++gpu_trace_windows_ == 4) {
+    if (REXCVAR_GET(vulkan_gpu_trace_frames) &&
+        ++gpu_trace_windows_ == REXCVAR_GET(vulkan_gpu_trace_frames_window)) {
       gpu_trace_frames_left_ = REXCVAR_GET(vulkan_gpu_trace_frames) - 1;
       gpu_trace_armed_ = true;
     }
diff --git a/src/graphics/vulkan/texture_cache.cpp b/src/graphics/vulkan/texture_cache.cpp
index 32ba09b..1524ee9 100644
--- a/src/graphics/vulkan/texture_cache.cpp
+++ b/src/graphics/vulkan/texture_cache.cpp
@@ -14,6 +14,12 @@
 
 #include <rex/cvar.h>
 REXCVAR_DECLARE(bool, vulkan_resolve_feed_textures);
+REXCVAR_DEFINE_BOOL(vulkan_texture_eager_transition, false, "GPU/Vulkan",
+                    "Transition a texture to the shader-read layout right after loading or "
+                    "feeding it (outside any render pass) instead of when a draw first binds it: "
+                    "on tile-based GPUs a barrier at bind time ends the render pass the draw is "
+                    "in, costing an attachment store and reload.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
 REXCVAR_DEFINE_BOOL(vulkan_resolve_feed_textures_no_mutable, false, "GPU/Vulkan",
                     "Experiment: textures fed by resolves get no mutable-format signed view")
     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
@@ -1838,6 +1844,9 @@ bool VulkanTextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& texture,
     copy_region.imageExtent.depth = std::max(depth >> level, UINT32_C(1));
   }
 
+  if (REXCVAR_GET(vulkan_texture_eager_transition)) {
+    TransitionTextureToGuestSampled(vulkan_texture);
+  }
   return true;
 }
 
@@ -2556,9 +2565,31 @@ VkImageView VulkanTextureCache::BeginResolveFeedDraw(const ResolveFeed& feed) {
 
 void VulkanTextureCache::EndResolveFeed(const ResolveFeed& feed) {
   MarkTextureUpToDate(*feed.texture);
+  if (REXCVAR_GET(vulkan_texture_eager_transition)) {
+    TransitionTextureToGuestSampled(*feed.texture);
+  }
   command_processor_.GpuTrace("feed");
 }
 
+void VulkanTextureCache::TransitionTextureToGuestSampled(VulkanTexture& texture) {
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kGuestShaderSampled);
+  if (old_usage == VulkanTexture::Usage::kGuestShaderSampled) {
+    return;
+  }
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kGuestShaderSampled, dst_stage_mask, dst_access_mask,
+                       new_layout);
+  if (!src_stage_mask) {
+    src_stage_mask = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+  }
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+}
+
 void VulkanTextureCache::TransitionTextureForComputeRead(VulkanTexture& texture) {
   texture.MarkAsUsed();
   VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kResolveDumpSource);
