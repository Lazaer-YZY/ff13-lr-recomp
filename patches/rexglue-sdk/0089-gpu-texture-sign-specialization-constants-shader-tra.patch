 void SpirvShaderTranslator::ProcessVertexFetchInstruction(
     const ParsedVertexFetchInstruction& instr) {
   UpdateInstructionPredication(instr.is_predicated, instr.predicate_condition);
@@ -1331,6 +1342,39 @@ void SpirvShaderTranslator::ProcessTextureFetchInstruction(
         swizzled_signs_word = const_uint_0_;
       }
       uint32_t swizzled_signs_word_offset = 8 * (fetch_constant_index & 3);
+      if (is_pixel_shader() && IsTextureSignSpecializationEnabled() &&
+          !REXCVAR_GET(spirv_debug_texture_signs_unsigned)) {
+        // Sign class of this fetch constant from a specialization constant (0 = runtime, the
+        // default). The pipeline gives classes 1-3 for the first kTextureSignClassSlots fetch
+        // constants when their bound textures match; the selects then fold to a constant byte
+        // in the host compiler, and the sign / gamma branches below with them.
+        spv::Id& sign_class = texture_sign_class_spec_[fetch_constant_index];
+        if (sign_class == spv::NoResult) {
+          sign_class = builder_->makeUintConstant(0, true);
+          builder_->addDecoration(sign_class, spv::DecorationSpecId,
+                                  int(kTextureSignClassSpecIdBase + fetch_constant_index));
+        }
+        spv::Id fixed_word = builder_->createTriOp(
+            spv::OpSelect, type_uint_,
+            builder_->createBinOp(spv::OpIEqual, type_bool_, sign_class,
+                                  builder_->makeUintConstant(kTextureSignClassGammaRgb)),
+            builder_->makeUintConstant(
+                uint32_t(kTextureSignClassSwizzledSigns[kTextureSignClassGammaRgb])
+                << swizzled_signs_word_offset),
+            builder_->makeUintConstant(
+                uint32_t(kTextureSignClassSwizzledSigns[kTextureSignClassGamma])
+                << swizzled_signs_word_offset));
+        fixed_word = builder_->createTriOp(
+            spv::OpSelect, type_uint_,
+            builder_->createBinOp(spv::OpIEqual, type_bool_, sign_class,
+                                  builder_->makeUintConstant(kTextureSignClassUnsigned)),
+            const_uint_0_, fixed_word);
+        swizzled_signs_word = builder_->createTriOp(
+            spv::OpSelect, type_uint_,
+            builder_->createBinOp(spv::OpIEqual, type_bool_, sign_class,
+                                  builder_->makeUintConstant(kTextureSignClassRuntime)),
+            swizzled_signs_word, fixed_word);
+      }
 
       spv::Builder::TextureParameters texture_parameters = {};
 
