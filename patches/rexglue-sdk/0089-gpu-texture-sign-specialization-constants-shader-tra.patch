From d247e2c2066c7b82bddfc93b8115904a063a8984 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Mon, 9 Nov 2026 19:23:56 +0800
Subject: [PATCH 089/108] gpu: texture sign specialization constants; shader
 translation really on the creation threads

Pixel shaders get one specialization constant per fetch constant they sample
(SpecId 1000 + index) with the sign class of the bound texture: 0 = runtime
(the system constant word, as before), 1 all unsigned, 2 gamma RGB + unsigned A,
3 all gamma. Selects on the constant fold in the host compiler, so the sign and
gamma branches of fetches whose textures are of a known class disappear. The
command processor computes the classes of the first 8 fetch constants of the
pixel shader's used texture mask from the texture cache's bindings; they are 16
bits of PipelineDescription (zero = the old hash, so stored pipelines stay
valid) and part of the fragment library key (VkSpecializationInfo on the
fragment stage, monolithic or GPL). A specialized pipeline that is not ready is
queued on the creation threads (or linked from cached libraries) and the draw
uses the runtime variant meanwhile; stored descriptions preload the variants.
Fragment library keys now include the translation switches; precompile marker
version 4. Cvar spirv_texture_sign_specialization (default on). Yusnaan view at
60 fps: 13.23 -> 11.97 Mcycles per frame (-9.5%), GPU 19.45 -> 17.60 ms.

IssueDraw translated new shaders synchronously before ConfigurePipeline, so
vulkan_async_shader_translation never ran (every log: 0 translations on the
creation threads; 6-14 ms each on the GPU thread, the 70-180 ms frames on
arrival). The command processor now leaves untranslated shaders to
ConfigurePipeline when the pipeline cache translates on the creation threads,
reading a shader's bindings only from a translation completed before the draw.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/pipeline/shader/spirv_translator.h b/include/rex/graphics/pipeline/shader/spirv_translator.h
index ed7e8ee..1d8726d 100644
--- a/include/rex/graphics/pipeline/shader/spirv_translator.h
+++ b/include/rex/graphics/pipeline/shader/spirv_translator.h
@@ -26,6 +26,42 @@ namespace rex::graphics {
 
 class SpirvShaderTranslator : public ShaderTranslator {
  public:
+  // Texture sign specialization (pixel shaders): each of the first kTextureSignClassSlots fetch
+  // constants a pixel shader uses (in ascending fetch constant order of its used texture mask)
+  // gets a specialization constant (SpecId kTextureSignClassSpecIdBase + fetch constant index)
+  // holding the sign class of its swizzled signs. Class 0 (the default) reads the signs from the
+  // system constants as without specialization; the others fix the swizzled signs byte, so the
+  // host compiler drops the sign / gamma handling that doesn't apply.
+  static constexpr uint32_t kTextureSignClassSpecIdBase = 1000;
+  static constexpr uint32_t kTextureSignClassSlots = 8;
+  static constexpr uint32_t kTextureSignClassBits = 2;
+  enum TextureSignClass : uint32_t {
+    kTextureSignClassRuntime = 0,
+    // Swizzled signs 0b00000000.
+    kTextureSignClassUnsigned = 1,
+    // Components 0-2 gamma, 3 unsigned: 0b00111111.
+    kTextureSignClassGammaRgb = 2,
+    // 0b11111111.
+    kTextureSignClassGamma = 3,
+  };
+  static constexpr uint8_t kTextureSignClassSwizzledSigns[4] = {0, 0b00000000, 0b00111111,
+                                                                0b11111111};
+  static TextureSignClass GetTextureSignClass(uint8_t swizzled_signs) {
+    switch (swizzled_signs) {
+      case 0b00000000:
+        return kTextureSignClassUnsigned;
+      case 0b00111111:
+        return kTextureSignClassGammaRgb;
+      case 0b11111111:
+        return kTextureSignClassGamma;
+      default:
+        return kTextureSignClassRuntime;
+    }
+  }
+  // Whether pixel shaders are translated with the sign class specialization constants
+  // (spirv_texture_sign_specialization).
+  static bool IsTextureSignSpecializationEnabled();
+
   union Modification {
     // If anything in this is structure is changed in a way not compatible with
     // the previous layout, invalidate the pipeline storages by increasing this
@@ -826,6 +862,10 @@ class SpirvShaderTranslator : public ShaderTranslator {
     spv::Id type_float_vectors_[4];
   };
 
+  // Sign class specialization constants by fetch constant index (pixel shaders), created on
+  // first use.
+  spv::Id texture_sign_class_spec_[32];
+
   spv::Id const_int_0_;
   spv::Id const_int4_0_;
   spv::Id const_uint_0_;
