From a9832e0dd0c70a5d5dfaa55391cf81bee1318986 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sun, 8 Nov 2026 16:03:45 +0800
Subject: [PATCH 065/108] gpu: the command thread waits for new commands
 without spinning or a timeout

Battle CPU profile on the Thor: the 'GPU Commands' thread spent 4.3% of all
process samples in clock_gettime and 3.5% in the kernel, from its idle loop
(500 sched_yield spins, then 5 ms timed waits on the write pointer event; a
timed wait reads the clock, which is expensive on this kernel).

- gpu_command_wait_untimed (default true): wait on the event without a
  timeout; CallInThread now sets the event (it relied on the timeout before);
  write pointer updates and Shutdown already set it.
- gpu_command_wait_spin_count (default 0, Xenia 501): yields before blocking.
- vulkan_fence_wait_sleep_us (default 0, diagnostic): poll submission fences
  with sleeps instead of a blocking vkWaitForFences (no effect measured).

Battle, same fight: process CPU 101-105% -> 93-98% of a core, clock reads gone
from the profile, GPU work and pacing unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..4c8090b 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -42,6 +42,12 @@ REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Disable for minor CPU overhead reduction, but may break memory coherency.")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(gpu_command_wait_untimed, true, "GPU",
+                    "The GPU command thread waits for new commands without a timeout (no "
+                    "clock reads; woken by write pointer updates, CallInThread, Shutdown).");
+REXCVAR_DEFINE_UINT32(gpu_command_wait_spin_count, 0, "GPU",
+                      "How many times the GPU command thread yields while waiting for new "
+                      "commands before it blocks on the write pointer event (Xenia: 501).");
 REXCVAR_DEFINE_BOOL(occlusion_query_enable, true, "GPU", "Enable host occlusion query handling")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
@@ -162,6 +168,9 @@ void CommandProcessor::CallInThread(std::function<void()> fn) {
     fn();
   } else {
     pending_fns_.push(std::move(fn));
+    // Wake the worker if it's waiting for commands (it may wait without a
+    // timeout, see gpu_command_wait_untimed).
+    write_ptr_index_event_->Set();
   }
 }
 
@@ -220,10 +229,15 @@ void CommandProcessor::WorkerThreadMain() {
       uint32_t loop_count = 0;
       do {
         // If we spin around too much, revert to a "low-power" state.
-        if (loop_count > 500) {
+        if (loop_count >= REXCVAR_GET(gpu_command_wait_spin_count)) {
+          // Timed waits read the clock (expensive on the Thor's kernel); the
+          // event is set by every write pointer update, CallInThread and
+          // Shutdown, so an untimed wait is enough.
           const int wait_time_ms = 5;
           rex::thread::Wait(write_ptr_index_event_.get(), true,
-                            std::chrono::milliseconds(wait_time_ms));
+                            REXCVAR_GET(gpu_command_wait_untimed)
+                                ? std::chrono::milliseconds::max()
+                                : std::chrono::milliseconds(wait_time_ms));
         }
 
         rex::thread::MaybeYield();
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 60cb656..eb57149 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -24,6 +24,7 @@
 
 #include <SPIRV/GlslangToSpv.h>
 #include <glslang/Public/ShaderLang.h>
+#include <rex/thread.h>
 #include <rex/assert.h>
 #include <rex/cvar.h>
 #include <rex/dbg.h>
@@ -67,6 +68,10 @@ REXCVAR_DEFINE_BOOL(vulkan_submit_on_primary_buffer_end, false, "GPU/Vulkan",
                     "every 8-16 frames on the Adreno 740 (cause not found yet).")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_UINT32(vulkan_fence_wait_sleep_us, 0, "GPU/Vulkan",
+                      "When the GPU thread must wait for a submission, poll the fences with "
+                      "sleeps of this many microseconds instead of a blocking vkWaitForFences "
+                      "(0 = blocking wait).");
 REXCVAR_DEFINE_BOOL(vulkan_submission_start_full_barrier, false, "GPU/Vulkan",
                     "Diagnostic: a full pipeline barrier at the start of every submission.");
 
@@ -5752,9 +5757,25 @@ void VulkanCommandProcessor::CheckSubmissionFenceAndDeviceLoss(uint64_t await_su
     // defined by vkQueueSubmit additionally include in the first
     // synchronization scope all commands that occur earlier in submission
     // order."
-    VkResult wait_result =
-        dfn.vkWaitForFences(device, uint32_t(await_submission - submission_completed_),
-                            submissions_in_flight_fences_.data(), VK_TRUE, UINT64_MAX);
+    VkResult wait_result;
+    uint32_t fence_wait_sleep_us = REXCVAR_GET(vulkan_fence_wait_sleep_us);
+    if (fence_wait_sleep_us) {
+      // Poll and sleep instead of a blocking driver wait (the driver may spin
+      // on the CPU while the GPU finishes).
+      while (true) {
+        wait_result =
+            dfn.vkWaitForFences(device, uint32_t(await_submission - submission_completed_),
+                                submissions_in_flight_fences_.data(), VK_TRUE, 0);
+        if (wait_result != VK_TIMEOUT) {
+          break;
+        }
+        rex::thread::Sleep(std::chrono::microseconds(fence_wait_sleep_us));
+      }
+    } else {
+      wait_result =
+          dfn.vkWaitForFences(device, uint32_t(await_submission - submission_completed_),
+                              submissions_in_flight_fences_.data(), VK_TRUE, UINT64_MAX);
+    }
     if (wait_result == VK_SUCCESS) {
       fences_awaited += await_submission - submission_completed_;
     } else {
