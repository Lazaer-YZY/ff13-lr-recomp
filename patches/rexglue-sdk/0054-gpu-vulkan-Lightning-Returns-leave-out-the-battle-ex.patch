From ec570f5fa99ec161faa5a030e87b52905550fef4 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Sun, 8 Nov 2026 09:27:30 +0800
Subject: [PATCH 054/108] gpu: vulkan: Lightning Returns: leave out the
 battle-exit grey filter on Android

The battle-exit grey filter (pixel shader 8DA8D0C5199404FF, drawn after the
frame's crossfade by the blend constant) flickers and shows full-screen line
noise on Adreno. Like lr-ffxiii-port, skip it in frames with a crossfade draw
(vulkan_lr_skip_battle_grey, default on Android).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 8a6fa1a..dd75007 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -986,6 +986,8 @@ class VulkanCommandProcessor : public CommandProcessor {
   static std::string GpuTimingDescribeTag(uint64_t tag);
   void GpuTimingShutdown();
   bool gpu_timing_enabled_ = false;
+  // vulkan_lr_skip_battle_grey: a crossfade draw happened in this frame.
+  bool lr_crossfade_this_frame_ = false;
   // 0 - not checked yet, 1 - supported, -1 - unsupported.
   int gpu_timing_support_ = 0;
   double gpu_timing_period_ns_ = 1.0;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 3b8903d..856134a 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -77,6 +77,11 @@ REXCVAR_DEFINE_BOOL(vulkan_gpu_timing, false, "GPU",
                     "transfers, resolves, texture loads, draws and submissions every 10 s")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(vulkan_lr_skip_battle_grey, REX_PLATFORM_ANDROID ? true : false, "GPU/Vulkan",
+                    "Lightning Returns: leave out the battle-exit grey filter overlay, which "
+                    "flickers and shows line noise on Adreno")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(vulkan_gpu_trace_frame, false, "GPU",
                     "With vulkan_gpu_timing, log the GPU command sequence of one frame (render "
                     "passes with their draw counts and end reasons, resolves, texture loads, "
@@ -2294,6 +2299,7 @@ void VulkanCommandProcessor::OnGammaRampPWLValueWritten() {
 void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
                                        uint32_t frontbuffer_height) {
   SCOPE_profile_cpu_f("gpu");
+  lr_crossfade_this_frame_ = false;
   if (gpu_timing_enabled_) {
     GpuTimingOnSwap();
   }
@@ -4314,6 +4320,23 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       return true;
     }
   }
+  // Lightning Returns: the battle-exit grey filter (a blurred, desaturated
+  // full-screen overlay, pixel shader 8DA8D0C5199404FF, drawn after the frame's
+  // crossfade by the blend constant) flickers / shows line noise on Adreno, so
+  // it is left out there (as lr-ffxiii-port does; vulkan_lr_skip_battle_grey).
+  if (REXCVAR_GET(vulkan_lr_skip_battle_grey)) {
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      uint32_t blend_control = regs.values[XE_GPU_REG_RB_BLENDCONTROL0 + i];
+      // Color source CONSTANT_COLOR, destination ONE_MINUS_CONSTANT_COLOR.
+      if ((blend_control & 0x1F) == 12 && ((blend_control >> 8) & 0x1F) == 13) {
+        lr_crossfade_this_frame_ = true;
+      }
+    }
+    if (lr_crossfade_this_frame_ && pixel_shader &&
+        pixel_shader->ucode_data_hash() == UINT64_C(0x8DA8D0C5199404FF)) {
+      return true;
+    }
+  }
   bool memexport_used_pixel = pixel_shader && (pixel_shader->memexport_eM_written() != 0);
   if (memexport_used_pixel) {
     if (!device_properties.fragmentStoresAndAtomics) {
