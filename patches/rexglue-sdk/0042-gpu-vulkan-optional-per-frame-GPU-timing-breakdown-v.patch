   current_render_pass_ = use_dynamic_rendering ? VK_NULL_HANDLE : render_pass;
   current_framebuffer_ = framebuffer;
 
+  ++gpu_timing_counters_.render_passes;
+  GpuTimingMark(GpuTimingCategory::kDraws);
+
