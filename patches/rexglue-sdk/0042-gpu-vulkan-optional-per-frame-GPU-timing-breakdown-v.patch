+bool VulkanPresenter::EnsurePaintGpuTimingQueryPool() {
+  if (paint_gpu_timing_support_) {
+    return paint_gpu_timing_support_ > 0;
+  }
+  paint_gpu_timing_support_ = -1;
+  const VulkanInstance::Functions& ifn = vulkan_device_->vulkan_instance()->functions();
+  VkPhysicalDeviceProperties physical_device_properties;
+  ifn.vkGetPhysicalDeviceProperties(vulkan_device_->physical_device(),
+                                    &physical_device_properties);
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device_->physical_device(),
+                                               &queue_family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device_->physical_device(),
+                                               &queue_family_count, queue_families.data());
+  uint32_t queue_family = vulkan_device_->queue_family_graphics_compute();
+  uint32_t valid_bits =
+      queue_family < queue_family_count ? queue_families[queue_family].timestampValidBits : 0;
+  float period = physical_device_properties.limits.timestampPeriod;
+  if (!valid_bits || !(period > 0.0f)) {
+    return false;
+  }
+  VkQueryPoolCreateInfo query_pool_create_info = {};
+  query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  query_pool_create_info.queryCount = 2 * PaintContext::kSubmissionCount;
+  if (vulkan_device_->functions().vkCreateQueryPool(vulkan_device_->device(),
+                                                    &query_pool_create_info, nullptr,
+                                                    &paint_gpu_timing_query_pool_) != VK_SUCCESS) {
+    REXLOG_ERROR("VulkanPresenter: Failed to create the paint timestamp query pool");
+    return false;
+  }
+  paint_gpu_timing_period_ns_ = double(period);
+  paint_gpu_timing_valid_mask_ =
+      valid_bits >= 64 ? UINT64_MAX : (UINT64_C(1) << valid_bits) - 1;
+  paint_gpu_timing_support_ = 1;
+  return true;
+}
+
 bool VulkanPresenter::InitializeSurfaceIndependent() {
   const VulkanDevice::Functions& dfn = vulkan_device_->functions();
   const VkDevice device = vulkan_device_->device();
