@@ -496,6 +498,11 @@ class RenderTargetCache {
     assert_true(GetPath() == Path::kHostRenderTargets);
     return last_update_transfers_;
   }
+  // Pixels of the depth render target that the current draw overwrites
+  // completely (gpu_skip_overwritten_transfers), not transferred - or nullptr.
+  const Transfer::Rectangle* last_update_transfer_cutout() const {
