From 3aa36f030b23b61d19352ff7c09a7dce3e49a9b5 Mon Sep 17 00:00:00 2001
From: LR Recomp <noreply@lr-recomp.invalid>
Date: Tue, 24 Nov 2026 17:47:51 +0800
Subject: [PATCH 120/120] gpu/vulkan: movies never stretched; centred zoom for
 bars on all four sides

gpu_keep_aspect_pixel_shaders' pillarbox now tells full-screen movies (largest plane at least
960x540) from movies placed in menus. A full-screen movie stays 16:9 on the screen also when
the presenter stretches the frame (gpu_keep_aspect_display_aspect), and one whose own picture
has black bars at the top and bottom as well (bars on all four sides) is zoomed, centred,
until the side or the top and bottom bars are gone, nothing of the picture cut off
(gpu_keep_aspect_zoom_letterbox, default on; bars measured from the luma plane in guest
memory and steadied over 15 frames; include/rex/graphics/util/letterbox.h).
gpu_keep_aspect_test_bars forces the bars for testing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/rex/graphics/util/letterbox.h b/include/rex/graphics/util/letterbox.h
new file mode 100644
index 0000000..79e866e
--- /dev/null
+++ b/include/rex/graphics/util/letterbox.h
@@ -0,0 +1,87 @@
+/**
+ * Letterbox bars of a movie frame, for gpu_keep_aspect_pixel_shaders' zoom (LR port, 2026-11-24).
+ *
+ * A movie kept 16:9 on a wider screen gets bars at the sides. When the movie's own picture also has black bars at the
+ * top and bottom (a wider film inside a 16:9 frame), it has bars on all four sides; then it is zoomed, centred, until
+ * either the side bars or the top and bottom bars are gone, so nothing of the picture is cut off. Pure logic (a luma
+ * reader callback), so host tests can include it.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace rex::graphics::letterbox {
+
+// Luma at or below this counts as black (video black is 16; compression noise stays a few steps above it).
+constexpr uint32_t kBlack = 24;
+// Samples across each row.
+constexpr uint32_t kSamples = 40;
+// Bars thinner than this (rows of the movie) are not worth a zoom.
+constexpr uint32_t kMinBars = 12;
+// A measurement has to repeat (within kTolerance rows) for this many frames before the zoom follows it.
+constexpr uint32_t kStableFrames = 15;
+constexpr uint32_t kTolerance = 2;
+
+// Rows of black at the top and the bottom of a movie frame when they match (a letterbox), 0 when the picture reaches
+// an edge or the dark rows differ between the top and the bottom (a dark sky, a dark floor), or -1 when the frame is
+// dark throughout (a fade: no information). luma(x, y) returns the luma (0-255) at a pixel of the frame;
+// visible_height is the movie's own height (a decoder's plane may be taller, padded).
+template <typename Luma>
+int32_t MeasureBars(uint32_t width, uint32_t visible_height, Luma&& luma) {
+  if (width < 64 || visible_height < 64) return 0;
+  auto dark_row = [&](uint32_t y) {
+    for (uint32_t i = 0; i < kSamples; ++i) {
+      const uint32_t x = 8 + i * (width - 16) / (kSamples - 1);
+      if (uint32_t(luma(x, y)) > kBlack) return false;
+    }
+    return true;
+  };
+  const uint32_t half = visible_height / 2;
+  uint32_t top = 0;
+  while (top < half && dark_row(top)) top += 2;
+  if (top >= half) return -1;
+  uint32_t bottom = 0;
+  while (bottom < half && dark_row(visible_height - 1 - bottom)) bottom += 2;
+  if (bottom >= half) return -1;
+  const uint32_t low = std::min(top, bottom), high = std::max(top, bottom);
+  if (high - low > 4) return 0;
+  return int32_t(low);
+}
+
+// The centred zoom for a movie with `bars` rows of black at the top and the bottom of its visible_height rows, shown
+// pillarboxed where at most max_zoom (the frame's width / the movie's width on screen) fills the width: the smaller of
+// "the side bars gone" and "the top and bottom bars gone". 1 = no zoom (no letterbox, or no side bars).
+inline float Zoom(float max_zoom, uint32_t visible_height, uint32_t bars) {
+  if (bars < kMinBars || max_zoom <= 1.0f || 4 * bars >= visible_height) return 1.0f;
+  const float fill_height = float(visible_height) / float(visible_height - 2 * bars);
+  return std::max(1.0f, std::min(max_zoom, fill_height));
+}
+
+// Steadies the measurements of one movie: the bars in use change only after a new measurement has repeated for
+// kStableFrames frames, so dark scenes and fades don't make the picture jump.
+class BarTracker {
+ public:
+  // One frame's MeasureBars result; returns the bars in use.
+  uint32_t Update(int32_t measured) {
+    if (measured < 0) return applied_;
+    const uint32_t bars = uint32_t(measured);
+    if (frames_ && Near(bars, candidate_)) {
+      ++frames_;
+    } else {
+      candidate_ = bars;
+      frames_ = 1;
+    }
+    if (frames_ >= kStableFrames && !Near(candidate_, applied_)) applied_ = candidate_;
+    return applied_;
+  }
+  void Reset() { candidate_ = applied_ = frames_ = 0; }
+  uint32_t applied() const { return applied_; }
+
+ private:
+  static bool Near(uint32_t a, uint32_t b) { return (a > b ? a - b : b - a) <= kTolerance; }
+  uint32_t candidate_ = 0, applied_ = 0, frames_ = 0;
+};
+
+}  // namespace rex::graphics::letterbox
