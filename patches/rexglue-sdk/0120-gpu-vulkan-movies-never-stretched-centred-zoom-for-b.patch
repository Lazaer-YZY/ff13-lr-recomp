@@ -5242,6 +5252,67 @@ Shader* VulkanCommandProcessor::LoadShader(xenos::ShaderType shader_type, uint32
   return pipeline_cache_->LoadShader(shader_type, host_address, dword_count);
 }
 
+// gpu_keep_aspect_zoom_letterbox: the centred zoom of a pillarboxed full-screen movie whose own picture has black bars
+// at the top and bottom (bars on all four sides), from its luma plane in guest memory (8 bits per pixel, linear or
+// tiled; read as whole 32-bit words, so the endian swap does not matter). max_zoom = the frame's width / the movie's
+// width on screen. The bars are steadied per movie (letterbox::BarTracker); a movie ends after 1 s without a frame.
+static float KeepAspectLetterboxZoom(const memory::Memory& memory, const xenos::xe_gpu_texture_fetch_t& fetch,
+                                     uint32_t width, uint32_t height, float max_zoom) {
+  static letterbox::BarTracker tracker;
+  static std::chrono::steady_clock::time_point last_frame;
+  static uint32_t logged_bars = 0;
+  static bool movie_logged = false;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last_frame > std::chrono::seconds(1)) {
+    tracker.Reset();
+    logged_bars = 0;
+    movie_logged = false;
+  }
+  last_frame = now;
+  // A decoder's plane is padded (1280x736 for a 1280x720 movie): the movie's own rows, at most 16:9.
+  const uint32_t visible_height = std::min(height, (width * 9 + 8) / 16);
+  uint32_t bars;
+  const int32_t test_bars = REXCVAR_GET(gpu_keep_aspect_test_bars);
+  if (test_bars >= 0) {
+    bars = uint32_t(test_bars);
+  } else {
+    if (fetch.format != xenos::TextureFormat::k_8) {
+      if (!movie_logged) {
+        movie_logged = true;
+        REXLOG_INFO("gpu keep aspect: full-screen movie {}x{} in format {}: its bars are not measured", width,
+                    height, uint32_t(fetch.format));
+      }
+      return 1.0f;
+    }
+    const uint32_t base = fetch.base_address << 12;
+    const uint32_t pitch = fetch.pitch << 5;
+    const bool tiled = fetch.tiled;
+    auto luma = [&](uint32_t x, uint32_t y) -> uint32_t {
+      x &= ~3u;
+      const uint32_t offset = tiled ? uint32_t(texture_util::GetTiledOffset2D(int32_t(x), int32_t(y), pitch, 0))
+                                    : y * pitch + x;
+      const uint8_t* p = memory.TranslatePhysical<const uint8_t*>(base + offset);
+      return std::max(std::max(p[0], p[1]), std::max(p[2], p[3]));
+    };
+    const int32_t measured = letterbox::MeasureBars(width, visible_height, luma);
+    bars = tracker.Update(measured);
+    if (!movie_logged && measured >= 0) {
+      movie_logged = true;
+      REXLOG_INFO("gpu keep aspect: full-screen movie {}x{} ({} rows shown, {}, pitch {}), first picture: {} rows of "
+                  "black at the top and bottom, luma {} / {} / {} at the left / centre / right of the middle row",
+                  width, height, visible_height, tiled ? "tiled" : "linear", pitch, measured,
+                  luma(width / 8, visible_height / 2), luma(width / 2, visible_height / 2),
+                  luma(width * 7 / 8, visible_height / 2));
+    }
+  }
+  if (bars != logged_bars) {
+    logged_bars = bars;
+    REXLOG_INFO("gpu keep aspect: movie {}x{} has {} rows of black at the top and bottom; zoom {:.3f}", width,
+                visible_height, bars, letterbox::Zoom(max_zoom, visible_height, bars));
+  }
+  return letterbox::Zoom(max_zoom, visible_height, bars);
+}
+
 bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
                                        IndexBufferInfo* index_buffer_info,
                                        bool major_mode_explicit) {
@@ -5787,6 +5858,10 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   // their viewport is wider, so a movie is not stretched across a wide screen: by default the picture is scaled up to
   // the full width (clip-space Y scaled about the centre, the top and bottom cropped: a movie's letterbox bars), with
   // gpu_keep_aspect_pillarbox a centred 16:9 viewport. From the Dark Souls II port (2026-11-21).
+  // LR (2026-11-24): a full-screen movie (its largest plane at least 960x540) stays 16:9 on the screen also when the
+  // presenter stretches the frame (gpu_keep_aspect_display_aspect), and a pillarboxed one whose picture has bars at
+  // the top and bottom too is zoomed until one pair of bars is gone (gpu_keep_aspect_zoom_letterbox). Smaller movies
+  // placed in menus (a title banner, a tutorial clip) follow the frame, as the menus do.
   if (pixel_shader) {
     static const std::vector<uint64_t> keep_aspect_shaders = [] {
       std::vector<uint64_t> hashes;
@@ -5804,13 +5879,43 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
         std::find(keep_aspect_shaders.begin(), keep_aspect_shaders.end(),
                   pixel_shader->ucode_data_hash()) != keep_aspect_shaders.end()) {
       const uint32_t width = viewport_info.xy_extent[0], height = viewport_info.xy_extent[1];
-      const uint32_t wanted = (height * 16 + 8) / 9;
-      if (height && width > wanted + 1) {
+      // The movie's luma plane: the binding with the largest texture.
+      xenos::xe_gpu_texture_fetch_t luma_fetch = {};
+      uint32_t luma_width = 0, luma_height = 0;
+      for (const Shader::TextureBinding& binding : pixel_shader->texture_bindings()) {
+        const xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+        if (fetch.dimension != xenos::DataDimension::k2DOrStacked) continue;
+        const uint32_t w = fetch.size_2d.width + 1, h = fetch.size_2d.height + 1;
+        if (w * h > luma_width * luma_height) {
+          luma_fetch = fetch;
+          luma_width = w;
+          luma_height = h;
+        }
+      }
+      const bool full_screen_movie = luma_width >= 960 && luma_height >= 540;
+      // The frame's pixels are square on the screen unless the presenter stretches the frame.
+      const double display_aspect = REXCVAR_GET(gpu_keep_aspect_display_aspect);
+      const float shown_aspect = full_screen_movie && display_aspect > 0.0
+                                     ? float(display_aspect)
+                                     : (height ? float(width) / float(height) : 0.0f);
+      // The width (in frame pixels) that shows 16:9 on the screen.
+      const float wanted = shown_aspect > 0.0f ? float(width) * (16.0f / 9.0f) / shown_aspect : float(width);
+      if (height && float(width) > wanted + 1.5f) {
         if (REXCVAR_GET(gpu_keep_aspect_pillarbox)) {
-          viewport_info.xy_offset[0] += (width - wanted) / 2;
-          viewport_info.xy_extent[0] = wanted;
+          float zoom = 1.0f;
+          if (full_screen_movie && REXCVAR_GET(gpu_keep_aspect_zoom_letterbox)) {
+            zoom = KeepAspectLetterboxZoom(*memory_, luma_fetch, luma_width, luma_height, float(width) / wanted);
+          }
+          const uint32_t shown = std::min(width, uint32_t(wanted * zoom + 0.5f));
+          viewport_info.xy_offset[0] += (width - shown) / 2;
+          viewport_info.xy_extent[0] = shown;
+          if (zoom > 1.0f) {
+            // The zoomed movie is taller than the frame: its own black bars beyond the top and bottom are cropped.
+            viewport_info.ndc_scale[1] *= zoom;
+            viewport_info.ndc_offset[1] *= zoom;
+          }
         } else {
-          const float zoom = float(width) * 9.0f / (16.0f * float(height));
+          const float zoom = float(width) / wanted;
           viewport_info.ndc_scale[1] *= zoom;
           viewport_info.ndc_offset[1] *= zoom;
         }
