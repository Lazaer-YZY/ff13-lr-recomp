-TextureCache::Texture* TextureCache::FindResolveFeedTexture(uint32_t base_address) {
+TextureCache::Texture* TextureCache::FindResolveFeedTextureContaining(uint32_t address,
+                                                                     xenos::TextureFormat format,
+                                                                     uint32_t& row_out) {
+  for (const auto& key_pair : resolve_feed_keys_) {
+    const TextureKey& key = key_pair.second;
+    uint32_t base = key.base_page << 12;
+    if (key.format != format || address <= base || !key.tiled) {
+      continue;
+    }
+    // Feedable formats are all 32bpp; a band of 32 rows of the tiled layout.
+    uint32_t band_bytes = key.pitch * 32 * 32 * 4;
+    uint32_t height_aligned = (uint32_t(key.height_minus_1) + 1 + 31) & ~uint32_t(31);
+    uint32_t offset = address - base;
+    if (!band_bytes || offset % band_bytes || offset / band_bytes * 32 >= height_aligned) {
+      continue;
+    }
+    auto texture_it = textures_.find(key);
+    if (texture_it == textures_.end()) {
+      continue;
+    }
+    row_out = offset / band_bytes * 32;
+    return texture_it->second.get();
+  }
+  return nullptr;
+}
+
+bool TextureCache::FindTextureKeyAtBase(uint32_t base_address, TextureKey& key_out) const {
+  for (const auto& texture_pair : textures_) {
+    if ((texture_pair.first.base_page << 12) == base_address) {
+      key_out = texture_pair.first;
+      return true;
+    }
+  }
+  return false;
+}
+
+TextureCache::Texture* TextureCache::FindResolveFeedTexture(uint32_t base_address,
+                                                           xenos::TextureFormat format) {
   if (base_address & 0xFFF) {
     return nullptr;
   }
-  auto key_it = resolve_feed_keys_.find(base_address >> 12);
+  auto key_it = resolve_feed_keys_.find(uint64_t(base_address >> 12) << 8 | uint32_t(format));
   if (key_it == resolve_feed_keys_.end()) {
     return nullptr;
   }
diff --git a/src/graphics/shaders/glsl/resolve_feed_depth.frag b/src/graphics/shaders/glsl/resolve_feed_depth.frag
new file mode 100644
index 0000000..4e4aa48
--- /dev/null
+++ b/src/graphics/shaders/glsl/resolve_feed_depth.frag
@@ -0,0 +1,19 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+// Resolve feed from a 1x depth render target (binding 0 of the depth / stencil
+// transfer source set) into an R32_SFLOAT texture, as k_24_8 textures are
+// loaded (24-bit unorm depth as float, stencil dropped).
+layout(set = 0, binding = 0) uniform texture2D xe_feed_depth;
+layout(push_constant) uniform XeFeedConstants {
+  ivec2 source_offset;
+  uint flags;
+} xe_feed;
+layout(location = 0) out vec4 xe_feed_color;
+void main() {
+  if ((xe_feed.flags & 2u) != 0u) {
+    xe_feed_color = vec4(0.5, 0.0, 0.0, 1.0);
+    return;
+  }
+  float depth = texelFetch(xe_feed_depth, ivec2(gl_FragCoord.xy) + xe_feed.source_offset, 0).r;
+  xe_feed_color = vec4(depth, 0.0, 0.0, 1.0);
+}
diff --git a/src/graphics/shaders/glsl/resolve_feed_uint.frag b/src/graphics/shaders/glsl/resolve_feed_uint.frag
new file mode 100644
index 0000000..f135deb
--- /dev/null
+++ b/src/graphics/shaders/glsl/resolve_feed_uint.frag
@@ -0,0 +1,19 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+// Resolve feed from a render target with a bit-exact UINT transfer view (e.g.
+// k_32_FLOAT as R32_UINT) into an R32_SFLOAT texture. flags bit 1: write a
+// debug value (vulkan_resolve_feed_debug).
+layout(set = 0, binding = 0) uniform utexture2D xe_feed_source;
+layout(push_constant) uniform XeFeedConstants {
+  ivec2 source_offset;
+  uint flags;
+} xe_feed;
+layout(location = 0) out vec4 xe_feed_color;
+void main() {
+  if ((xe_feed.flags & 2u) != 0u) {
+    xe_feed_color = vec4(1.0, 0.0, 1.0, 1.0);
+    return;
+  }
+  uvec4 bits = texelFetch(xe_feed_source, ivec2(gl_FragCoord.xy) + xe_feed.source_offset, 0);
+  xe_feed_color = vec4(uintBitsToFloat(bits.r), 0.0, 0.0, 1.0);
+}
