diff --git a/src/graphics/vulkan/render_target_cache.cpp b/src/graphics/vulkan/render_target_cache.cpp
index 90b2a96..95391b9 100644
--- a/src/graphics/vulkan/render_target_cache.cpp
+++ b/src/graphics/vulkan/render_target_cache.cpp
@@ -37,6 +37,14 @@
 #include <rex/math.h>
 #include <rex/ui/vulkan/util.h>
 
+REXCVAR_DEFINE_BOOL(vulkan_resolve_feed_textures, false, "GPU/Vulkan",
+                    "Experimental: copy 1x k_8_8_8_8 resolves straight from the render target "
+                    "into the cached texture that samples the resolved memory (same format, "
+                    "endianness and pitch, single level, no red/blue swap), keeping it valid "
+                    "instead of reloading it from guest memory. Guest memory is still written. "
+                    "Lightning Returns' resolves all swap red and blue, which a copy can't do.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_STRING(render_target_path_vulkan, "", "GPU/Vulkan",
                       "Vulkan render target implementation path")
     .lifecycle(rex::cvar::Lifecycle::kInitOnly);
@@ -1386,9 +1394,61 @@ bool VulkanRenderTargetCache::Resolve(const memory::Memory& memory,
           command_processor_.GpuTimingMark(VulkanCommandProcessor::GpuTimingCategory::kResolves);
           command_buffer.CmdVkDispatch(copy_group_count_x, copy_group_count_y, 1);
 
+          // Resolve feeding: a 1x k_8_8_8_8 render target region copied straight
+          // into the cached texture that samples it (vulkan_resolve_feed_textures).
+          VulkanTextureCache::ResolveFeed resolve_feed;
+          int32_t resolve_feed_x = 0, resolve_feed_y = 0;
+          bool resolve_feed_ok = false;
+          if (direct_resolved && !direct_host_resolve.is_depth &&
+              REXCVAR_GET(vulkan_resolve_feed_textures)) {
+            RenderTargetKey feed_rt_key = direct_host_resolve.render_target->key();
+            uint32_t feed_pitch = feed_rt_key.pitch_tiles_at_32bpp;
+            if (feed_rt_key.msaa_samples == xenos::MsaaSamples::k1X &&
+                feed_rt_key.GetColorFormat() == xenos::ColorRenderTargetFormat::k_8_8_8_8 &&
+                feed_pitch && resolve_info.color_edram_info.pitch_tiles == feed_pitch &&
+                texture_cache.PrepareResolveFeed(resolve_info, resolve_feed)) {
+              uint32_t feed_rel_tiles =
+                  (resolve_info.color_edram_info.base_tiles - feed_rt_key.base_tiles) &
+                  (xenos::kEdramTileCount - 1);
+              resolve_feed_x =
+                  int32_t((feed_rel_tiles % feed_pitch) * xenos::kEdramTileWidthSamples +
+                          resolve_info.coordinate_info.edram_offset_x_div_8 * 8);
+              resolve_feed_y =
+                  int32_t((feed_rel_tiles / feed_pitch) * xenos::kEdramTileHeightSamples +
+                          resolve_info.coordinate_info.edram_offset_y_div_8 * 8);
+              static uint32_t feed_logs = 0;
+              if (feed_logs < 20) {
+                ++feed_logs;
+                REXGPU_INFO("Resolve feed @{:08X}: texture {}x{} at ({}, {}), from render target "
+                            "({}, {}) base {} pitch {}",
+                            resolve_info.copy_dest_base, resolve_feed.width, resolve_feed.height,
+                            resolve_feed.dest_x, resolve_feed.dest_y, resolve_feed_x,
+                            resolve_feed_y, uint32_t(feed_rt_key.base_tiles), feed_pitch);
+              }
+              resolve_feed_ok =
+                  uint32_t(resolve_feed_x) + resolve_feed.width <=
+                      feed_pitch * xenos::kEdramTileWidthSamples &&
+                  uint32_t(resolve_feed_y) + resolve_feed.height <=
+                      GetRenderTargetHeight(feed_pitch, xenos::MsaaSamples::k1X);
+            }
+          }
+
           // Invalidate textures and mark the range as scaled if needed.
           texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
                                             resolve_info.copy_dest_extent_length);
+          if (resolve_feed_ok) {
+            VulkanRenderTarget& feed_rt = *direct_host_resolve.render_target;
+            command_processor_.PushImageMemoryBarrier(
+                feed_rt.image(),
+                ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+                feed_rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+                feed_rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT,
+                feed_rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+            feed_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                             VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+            texture_cache.FinishResolveFeed(resolve_feed, feed_rt.image(), resolve_feed_x,
+                                            resolve_feed_y);
+          }
           written_address_out = resolve_info.copy_dest_extent_start;
           written_length_out = resolve_info.copy_dest_extent_length;
           copied = true;
diff --git a/src/graphics/vulkan/texture_cache.cpp b/src/graphics/vulkan/texture_cache.cpp
index e0bf139..7bd0bd5 100644
--- a/src/graphics/vulkan/texture_cache.cpp
+++ b/src/graphics/vulkan/texture_cache.cpp
@@ -2332,6 +2332,102 @@ void VulkanTextureCache::UseScaledResolveBufferForWrite(uint64_t written_start_s
   scaled_resolve_last_written_range_ = std::make_pair(written_start_scaled, written_length_scaled);
 }
 
+bool VulkanTextureCache::PrepareResolveFeed(const draw_util::ResolveInfo& resolve_info,
+                                            ResolveFeed& feed_out) {
+  feed_out = ResolveFeed();
+  // Logs the first reasons a resolve can't feed a texture (diagnostics).
+  static uint32_t reject_logs = 0;
+  auto reject = [&](const char* reason, uint64_t a = 0, uint64_t b = 0) {
+    if (reject_logs < 40) {
+      ++reject_logs;
+      REXGPU_INFO("Resolve feed @{:08X}: no ({}: {:X} {:X})", resolve_info.copy_dest_base, reason,
+                  a, b);
+    }
+    return false;
+  };
+  const reg::RB_COPY_DEST_INFO& dest_info = resolve_info.copy_dest_info;
+  if (dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 || dest_info.copy_dest_swap ||
+      dest_info.copy_dest_exp_bias || dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian128::k16in32)) {
+    return reject("dest info", dest_info.value);
+  }
+  Texture* texture = FindResolveFeedTexture(resolve_info.copy_dest_base);
+  if (!texture) {
+    return reject("no texture loaded at the address");
+  }
+  TextureKey key = texture->key();
+  if (key.format != xenos::TextureFormat::k_8_8_8_8 || key.signed_separate ||
+      uint32_t(key.endianness) != uint32_t(dest_info.copy_dest_endian) ||
+      key.pitch != resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 ||
+      (key.base_page << 12) != resolve_info.copy_dest_base) {
+    return reject("texture key (format, signed, endian, pitch | dest endian, pitch)",
+                  uint64_t(key.format) << 32 | uint64_t(key.signed_separate) << 24 |
+                      uint64_t(key.endianness) << 16 | key.pitch,
+                  uint64_t(dest_info.copy_dest_endian) << 16 |
+                      resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32);
+  }
+  const HostFormatPair& host_format = GetHostFormatPair(key);
+  if (host_format.format_unsigned.format != VK_FORMAT_R8G8B8A8_UNORM ||
+      host_format.format_unsigned.block_compressed) {
+    return reject("host format", host_format.format_unsigned.format);
+  }
+  // Must be valid now: only this resolve's write may make it outdated.
+  if (texture->outdated_mask()) {
+    return reject("texture already outdated", texture->outdated_mask());
+  }
+  int32_t dest_x = int32_t(resolve_info.copy_dest_coordinate_info.offset_x_div_8 * 8);
+  int32_t dest_y = int32_t(resolve_info.copy_dest_coordinate_info.offset_y_div_8 * 8);
+  uint32_t texture_width = key.width_minus_1 + 1;
+  uint32_t texture_height = key.height_minus_1 + 1;
+  if (uint32_t(dest_x) >= texture_width || uint32_t(dest_y) >= texture_height) {
+    return reject("dest offset outside", uint64_t(dest_x) << 32 | uint32_t(dest_y),
+                  uint64_t(texture_width) << 32 | texture_height);
+  }
+  feed_out.texture = static_cast<VulkanTexture*>(texture);
+  feed_out.dest_x = dest_x;
+  feed_out.dest_y = dest_y;
+  feed_out.width =
+      std::min(uint32_t(resolve_info.coordinate_info.width_div_8 * 8),
+               texture_width - uint32_t(dest_x));
+  feed_out.height =
+      std::min(uint32_t(resolve_info.height_div_8 * 8), texture_height - uint32_t(dest_y));
+  return feed_out.width && feed_out.height;
+}
+
+void VulkanTextureCache::FinishResolveFeed(const ResolveFeed& feed, VkImage source_image,
+                                           int32_t source_x, int32_t source_y) {
+  VulkanTexture& texture = *feed.texture;
+  texture.MarkAsUsed();
+  VulkanTexture::Usage texture_old_usage =
+      texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  if (texture_old_usage != VulkanTexture::Usage::kTransferDestination) {
+    VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+    VkAccessFlags src_access_mask, dst_access_mask;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(texture_old_usage, src_stage_mask, src_access_mask, old_layout);
+    GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                         dst_access_mask, new_layout);
+    command_processor_.PushImageMemoryBarrier(
+        texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+        dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  }
+  command_processor_.SubmitBarriers(true);
+  command_processor_.GpuTimingMark(VulkanCommandProcessor::GpuTimingCategory::kResolves);
+  VkImageCopy region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.srcOffset = {source_x, source_y, 0};
+  region.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.dstSubresource.layerCount = 1;
+  region.dstOffset = {feed.dest_x, feed.dest_y, 0};
+  region.extent = {feed.width, feed.height, 1};
+  command_processor_.deferred_command_buffer().CmdVkCopyImage(
+      source_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  MarkTextureUpToDate(texture);
+  command_processor_.GpuTrace("feed");
+}
+
 bool VulkanTextureCache::Initialize() {
   const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
   const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
