diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
index 76f5600..630cc7e 100644
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -446,10 +446,34 @@ bool TextureCache::CommitPreparedTextureLoad(const PendingTextureLoad& pending_l
   // not up to date anymore.
   texture.MakeUpToDateAndWatch(global_critical_region_.Acquire());
   texture.LogAction("Loaded");
-
+  if (pending_load.load_base && texture_key.dimension == xenos::DataDimension::k2DOrStacked &&
+      !texture_key.depth_or_array_size_minus_1 && !texture_key.mip_max_level &&
+      texture_key.tiled && !texture_key.scaled_resolve) {
+    resolve_feed_keys_[texture_key.base_page] = texture_key;
+  }
   return true;
 }
 
+TextureCache::Texture* TextureCache::FindResolveFeedTexture(uint32_t base_address) {
+  if (base_address & 0xFFF) {
+    return nullptr;
+  }
+  auto key_it = resolve_feed_keys_.find(base_address >> 12);
+  if (key_it == resolve_feed_keys_.end()) {
+    return nullptr;
+  }
+  auto texture_it = textures_.find(key_it->second);
+  if (texture_it == textures_.end()) {
+    resolve_feed_keys_.erase(key_it);
+    return nullptr;
+  }
+  return texture_it->second.get();
+}
+
+void TextureCache::MarkTextureUpToDate(Texture& texture) {
+  texture.MakeUpToDateAndWatch(global_critical_region_.Acquire());
+}
