Subject: [PATCH 100/108] gpu: Xenos multiply switches also cover the vector
 mul/mad path; special functions clamp infinities when off


diff --git a/include/rex/graphics/pipeline/shader/spirv_translator.h b/include/rex/graphics/pipeline/shader/spirv_translator.h
index dfe2a7a..b01a15a 100644
--- a/include/rex/graphics/pipeline/shader/spirv_translator.h
+++ b/include/rex/graphics/pipeline/shader/spirv_translator.h
@@ -694,6 +694,10 @@ class SpirvShaderTranslator : public ShaderTranslator {
   // replaces the value with +0 if the minimum of the two operands is 0. This
   // must be called with absolute values of operands - use GetAbsoluteOperand!
   spv::Id ZeroIfAnyOperandIsZero(spv::Id value, spv::Id operand_0_abs, spv::Id operand_1_abs);
+  // vulkan_shader_xenos_multiply (and _vertex for vertex shaders) for this shader.
+  bool XenosMultiplyEmulated() const;
+  // With the Xenos multiply off: clamps a special function's +-infinity to +-FLT_MAX.
+  spv::Id ClampInfinityIfHostMultiply(spv::Id value);
   // Conditionally discard the current fragment. Changes the build point.
   void KillPixel(spv::Id condition, uint8_t memexport_eM_potentially_written_before);
   // Return type is a rex::bit_count(result.GetUsedResultComponents())-component
diff --git a/src/graphics/pipeline/shader/spirv_translator_alu.cpp b/src/graphics/pipeline/shader/spirv_translator_alu.cpp
index 667ab80..53a9430 100644
--- a/src/graphics/pipeline/shader/spirv_translator_alu.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator_alu.cpp
@@ -34,11 +34,27 @@ REXCVAR_DEFINE_BOOL(vulkan_shader_xenos_multiply_vertex, true, "GPU/Vulkan",
 
 namespace rex::graphics {
 
+bool SpirvShaderTranslator::XenosMultiplyEmulated() const {
+  return REXCVAR_GET(vulkan_shader_xenos_multiply) &&
+         (!is_vertex_shader() || REXCVAR_GET(vulkan_shader_xenos_multiply_vertex));
+}
+
+spv::Id SpirvShaderTranslator::ClampInfinityIfHostMultiply(spv::Id value) {
+  // Without the Xenos multiply emulation, keep the special functions' infinities out of plain
+  // multiplies: rsq(0) / rcp(0) / log(0) / exp overflow become +-FLT_MAX, so the common
+  // normalize(0) = 0 * rsq(0) still gives 0 (as 0 * inf does on Xenos) instead of NaN.
+  if (XenosMultiplyEmulated()) {
+    return value;
+  }
+  return builder_->createBuiltinCall(
+      type_float_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
+      {value, builder_->makeFloatConstant(-FLT_MAX), builder_->makeFloatConstant(FLT_MAX)});
+}
+
 spv::Id SpirvShaderTranslator::ZeroIfAnyOperandIsZero(spv::Id value, spv::Id operand_0_abs,
                                                       spv::Id operand_1_abs) {
   EnsureBuildPointAvailable();
-  if (!REXCVAR_GET(vulkan_shader_xenos_multiply) ||
-      (is_vertex_shader() && !REXCVAR_GET(vulkan_shader_xenos_multiply_vertex))) {
+  if (!XenosMultiplyEmulated()) {
     return value;
   }
   int num_components = builder_->getNumComponents(value);
@@ -208,7 +224,10 @@ spv::Id SpirvShaderTranslator::ProcessVectorAluOperation(
       uint32_t multiplicands_different =
           used_result_components &
           ~instr.vector_operands[0].GetIdenticalComponents(instr.vector_operands[1]);
-      if (multiplicands_different) {
+      // Same switches as ZeroIfAnyOperandIsZero: this path ignored them, so turning the Xenos
+      // multiply off removed only ~25% of the checks (2026-11-11: the vector mul/mad checks are
+      // ~33-41% of the main-pass shaders' instructions on the Thor).
+      if (multiplicands_different && XenosMultiplyEmulated()) {
         // Shader Model 3: +0 or denormal * anything = +-0.
         spv::Id different_operands[2] = {multiplicands[0], multiplicands[1]};
         spv::Id different_result = result;
@@ -1028,12 +1047,15 @@ spv::Id SpirvShaderTranslator::ProcessScalarAluOperation(
               const_float_0_),
